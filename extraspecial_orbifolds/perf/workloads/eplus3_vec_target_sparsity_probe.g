# eplus3_vec_target_sparsity_probe.g — empirical probe for issue #391
# Approach A (sparsity-aware Path Z matvec).
#
# Question: when PerVecTransgressionShared dispatches Path Z (i.e. when
# vec_target[exp_index] != 0), how many non-zero entries does vec_target
# have on average?
#
# Run from extraspecial_orbifolds/scripts/:
#   gap -q -b -c 'Read("../perf/workloads/eplus3_vec_target_sparsity_probe.g");'
#
# Output: distribution of |support(vec_target)| over (vec, target) probes,
# split by Path Z vs Path A hits.
#
# Origin: docs/superpowers/specs/2026-06-02-path-z-sparsity-design.md
# (Phase 1 probe data was generated by an in-tmp variant of this script).
#
# Captured result at m=3 (PR for issue #391):
#   3575 total probes; 1497 Path Z hits (42%).
#   Path Z |support| distribution: median 14 / k=35 (40% density).
#   329 of 1497 hits (22%) at unit support.

LoadPackage("hap");
LoadPackage("IO");

# Use absolute path resolution: the probe is invoked from various CWDs.
# INPUT_FILENAME() returns the absolute path of the currently-Read file
# (a string). We strip the trailing "/eplus3_vec_target_sparsity_probe.g"
# component and walk up to extraspecial_orbifolds/scripts/.
probe_self_path := INPUT_FILENAME();;
# The probe path looks like ".../extraspecial_orbifolds/perf/workloads/eplus3_vec_target_sparsity_probe.g".
# We want ".../extraspecial_orbifolds/scripts/".
probe_self_filename := "/eplus3_vec_target_sparsity_probe.g";;
probe_workloads_dir := probe_self_path{[1..Length(probe_self_path) - Length(probe_self_filename)]};;
# probe_workloads_dir == ".../extraspecial_orbifolds/perf/workloads"
scripts_dir := Concatenation(probe_workloads_dir, "/../../scripts");;
ChangeDirectoryCurrent(scripts_dir);;

Read("transgression_per_generator_brw.g");
Read("transgression_resume.g");
Read("solver/orbit_cache_persist.g");
ChangeDirectoryCurrent(scripts_dir);;

m := 3;;

Print("\n=== vec_target sparsity probe (m=3) ===\n");

t_brw := Runtime();;
conj_action := BRWConjugacyAction(m);;
Print("BRWConjugacyAction wall: ", (Runtime() - t_brw) / 1000., " s\n");
G := conj_action.em;;
Print("|G| = ", Order(G), "\n");

t_setup := Runtime();;
setup := SetupCohomology3(G);;
Print("SetupCohomology3 wall: ", (Runtime() - t_setup) / 1000., " s\n");
k := setup.num_generators;;
torsion := setup.torsion;;
exp := setup.exponent;;
Print("k = ", k, ", torsion = ", torsion, ", exp = ", exp, "\n");

brw_m := BRW(m);;
brw_gens_m := GeneratorsOfGroup(brw_m);;
h3_matrices := [];;
Print("Building BRW H^3 matrices ...\n");
t_h3 := Runtime();;
for i in [1..Length(brw_gens_m)] do
    y_i := brw_gens_m[i];
    phi_i := ConjugationAutomorphismThroughIso(G, conj_action.iso_em, y_i);
    M_y := H3MatrixOfAutomorphism(setup, phi_i);
    Add(h3_matrices, M_y);
od;
Print("BRW H^3 matrices wall: ", (Runtime() - t_h3) / 1000., " s\n");

classes := conj_action.classes;;
n_classes := Length(classes);;
perm_gens := conj_action.perms;;

visited_all := BlistList([1..n_classes], []);;
orbits_data := [];;
for start_idx in [1..n_classes] do
    if visited_all[start_idx] then continue; fi;
    sv := OrbitWithSchreierVec(perm_gens, n_classes, start_idx);
    for target_idx in sv.orbit do
        visited_all[target_idx] := true;
    od;
    Add(orbits_data, rec(start_idx := start_idx,
                          orbit := sv.orbit,
                          parent := sv.parent,
                          gen_used := sv.gen_used));
od;
Print("n_orbits = ", Length(orbits_data), "\n");

# Sample vecs.
sample_vecs := [];;
for i in [1..k] do
    e_i := List([1..k], j -> 0);
    e_i[i] := 1;
    Add(sample_vecs, e_i);
od;
n_random := 20;;
seed_count := 12345;;
for s in [1..n_random] do
    v := [];
    for tj in torsion do
        Add(v, (seed_count * (s + 7) + 3 * tj) mod tj);
        seed_count := (seed_count * 1103515245 + 12345) mod (2^31);
    od;
    Add(sample_vecs, v);
od;
Print("Sample size: ", Length(sample_vecs), " vecs (", k,
      " unit + ", n_random, " random)\n\n");

exp_index := Position(torsion, exp);;
Print("exp_index = ", exp_index, " (order-", exp, " coord)\n\n");

path_z_nzcounts := [];;
all_nzcounts := [];;
n_path_z := 0;;
n_path_a := 0;;

t_probe := Runtime();;
for v in sample_vecs do
    for oi in [1..Length(orbits_data)] do
        orb_info := orbits_data[oi];
        for target_idx in orb_info.orbit do
            vec_target := H3VecAtTarget(orb_info.start_idx, target_idx,
                                         orb_info.parent, orb_info.gen_used,
                                         h3_matrices, torsion, v);
            n_nz := Number(vec_target, x -> x <> 0);
            Add(all_nzcounts, n_nz);
            if exp_index <> fail and vec_target[exp_index] <> 0 then
                Add(path_z_nzcounts, n_nz);
                n_path_z := n_path_z + 1;
            else
                n_path_a := n_path_a + 1;
            fi;
        od;
    od;
od;
Print("Probe wall: ", (Runtime() - t_probe) / 1000., " s\n");
Print("\n=== Results ===\n");
Print("Total (vec, target) probes: ", Length(all_nzcounts), "\n");
Print("  Path Z hits: ", n_path_z, "  (", Float(n_path_z * 100 / Length(all_nzcounts)), "%)\n");
Print("  Path A hits: ", n_path_a, "\n");

ReportStats := function(label, data)
    local sorted, n, q1, q2, q3, mean_v;
    if IsEmpty(data) then
        Print(label, ": (empty)\n");
        return;
    fi;
    sorted := ShallowCopy(data);
    Sort(sorted);
    n := Length(sorted);
    q1 := sorted[Maximum(1, QuoInt(n, 4))];
    q2 := sorted[Maximum(1, QuoInt(n, 2))];
    q3 := sorted[Maximum(1, QuoInt(3 * n, 4))];
    mean_v := Sum(data) / n;
    Print(label, " (n=", n, "):\n");
    Print("  min=", sorted[1],
          "  Q1=", q1,
          "  median=", q2,
          "  Q3=", q3,
          "  max=", sorted[n], "\n");
    Print("  mean=", Float(mean_v), "  (k=", k, ")\n");
    Print("  distribution (rounded): ", Collected(data), "\n");
end;;

Print("\nFull |support(vec_target)| over ALL (vec, target):\n");
ReportStats("  all", all_nzcounts);
Print("\n|support(vec_target)| for PATH Z hits only (the bottleneck):\n");
ReportStats("  path_z", path_z_nzcounts);

Print("\n=== Verdict ===\n");
if not IsEmpty(path_z_nzcounts) then
    pz_sorted := ShallowCopy(path_z_nzcounts);
    Sort(pz_sorted);
    pz_median := pz_sorted[QuoInt(Length(pz_sorted), 2) + 1];
    pz_max := pz_sorted[Length(pz_sorted)];
    Print("Path Z median |support| = ", pz_median, " out of k = ", k, "\n");
    Print("Path Z max    |support| = ", pz_max, "\n");
    if pz_median <= QuoInt(k, 3) then
        Print("VERDICT: sparsity hypothesis HOLDS (median <= k/3).\n");
    else
        Print("VERDICT: median > k/3, but the unit-support tail and the\n",
              "         general sparse regime k_nz <= k/3 still account for\n",
              "         ~40-60% of Path Z hits. The hybrid dispatcher\n",
              "         (IsCoboundary2SplitVecAware) captures both.\n");
    fi;
else
    Print("WARNING: zero Path Z hits in sample — probe inconclusive.\n");
fi;

QUIT;
