+HAP_AFW5e_touched := [];;
+HAP_AFW5e_D := 64;;
+HAP_AFW5e_G_max := 64;;
+HAP_AFW5e_stride := 2 * HAP_AFW5e_D + 1;;
+HAP_AFW5e_MIN_SMALL := 24;;
