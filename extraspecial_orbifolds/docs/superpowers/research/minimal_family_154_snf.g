# minimal_family_154_snf.g
#
# Compute kernel size of restriction maps using Smith Normal Form.
# This works for m=2 AND m=3 (and beyond, for any candidate family).
#
# Strategy: H^3(G; U(1)) is the finite abelian group ⊕_i Z/t_i where
# t = torsion_G. For a family F = {H_1, ..., H_k}, the restriction map
#
#   R: ⊕ Z/t_i → ⊕_{H in F} ⊕_j Z/torsion_H[j]
#
# is determined by stacking the per-H restriction matrices vertically
# (well, by concatenation: the result of applying R to omega is the
# concatenation of res_{H_1}(omega), ..., res_{H_k}(omega)).
#
# Equivalently, write R as a single (k_G × N) integer matrix M where
# N = sum |torsion_H_i|. Then ker(R) = {omega ∈ Z^{k_G} | M*omega ∈ Lambda_H}
# modulo Lambda_G, where Lambda_G = D_G.Z^{k_G} (diag torsion), and
# Lambda_H = D_H.Z^N.
#
# To get |ker(R)| via integer linear algebra:
#   * Compute the lattice L = preimage of Lambda_H under M, as a
#     sublattice of Z^{k_G}.
#   * |ker(R)| = |L / Lambda_G|.
#
# Equivalently: stack the augmented matrix
#
#   A = [ M ; D_H ]   ((k_G + N) × N integer matrix, then transpose)
#
# Wait, simpler approach: the IMAGE of R has size
#   |image| = |Z^N| / |Z^N coker(<M cols of M | D_H cols>)|
#
# Actually the cleanest computation: use SmithNormalForm to compute
# the structure of the cokernel of the composite map
#
#   Z^{k_G} ⊕ Z^N --[ M | -D_H ]--> Z^N
#
# Then |image(R)| = product of finite invariant factors of the
# cokernel-component coming from the M (left) factor.
#
# IMO easiest: directly compute |ker(R)|, by using HermiteNormalForm
# on M to find the integer lattice of omega's such that M.omega
# lies in Lambda_H. Then mod by Lambda_G.
#
# === Implementation ===
# Form M, D_G, D_H. Let N = number of columns. Build the (k_G + N) × N
# matrix B := [ M ; -D_H ]. Its row space mod Z^N is the image of
# Z^{k_G + N} in the H-side. The image of R alone is the projection of
# the M-rows mod the D_H rows.
#
# To compute |image(R)| as a subgroup of ⊕ Z/torsion_H_j: stack
#   B = vertical-concat(rows of M, rows of D_H)
# of shape ((k_G + N) × N). The SNF of B gives invariant factors of
# Z^N / row_space(B). |image of M| = |Z^N / row_space([D_H])| /
# |Z^N / row_space([M; D_H])| = ∏ torsion_H / |coker(B)|.
#
# Then |ker(R)| = |H^3(G)| / |image(R)| = (∏ t_i) / |image(R)|.

ChangeDirectoryCurrent(
  "/Users/thomasgemunden/Projects/group_cohomology/DRINFELD-wt-dvan-math-154/extraspecial_orbifolds/scripts");

Read("detecting_family_restriction.g");

# Build the stacked restriction matrix and torsion vector for a family.
# Returns rec(M := k_G × N matrix, T_H := length-N torsion vector).
BuildFamilyM := function(data, ea_indices, include_D8, include_Q8)
    local M_blocks, T_blocks, j, k_G, M, T_H;
    M_blocks := [];
    T_blocks := [];
    k_G := Length(data.torsion_G);
    for j in ea_indices do
        Add(M_blocks, data.res_EA_list[j]);
        Append(T_blocks, data.torsion_EA_list[j]);
    od;
    if include_D8 then
        Add(M_blocks, data.res_D8);
        Append(T_blocks, data.torsion_D8);
    fi;
    if include_Q8 and data.res_Q8 <> fail then
        Add(M_blocks, data.res_Q8);
        Append(T_blocks, data.torsion_Q8);
    fi;
    # Concatenate columns: each block is k_G × k_H_j, we want k_G × N.
    M := TransposedMat(Concatenation(List(M_blocks, TransposedMat)));
    T_H := T_blocks;
    return rec(M := M, T_H := T_H);
end;;

# Compute the order of the image of the restriction map. Strategy:
# the H-side ambient group is A_H = ⊕ Z/T_H[j]. The image of M is
# the subgroup of A_H generated by the rows of M (each row = image of
# the i-th G-side unit generator).
# |image| = |<rows of M> as subgroup of A_H|.
# Compute via stacking M atop D_H = diag(T_H) and SNF.
# Concretely: B := [ M ; D_H ] ((k_G + N) × N matrix). The cokernel
# Z^N / row_space(B) has order = ∏ (invariant factors of B). But
# Z^N / row_space(D_H) = A_H has order ∏ T_H. So
#   |image(M) inside A_H| = |A_H| / |Z^N / row_space([M; D_H])|
#                        = (∏ T_H) / (∏ inv-factors of B).
ImageOrder := function(M, T_H)
    local N, D_H, B, snf, factors, k_G;
    k_G := Length(M);
    N := Length(T_H);
    # D_H is the diagonal torsion matrix.
    D_H := List([1..N], i -> List([1..N], j ->
                If_(i = j, T_H[i], 0)));
    B := Concatenation(M, D_H);
    snf := SmithNormalFormIntegerMat(B);
    # snf is the SNF matrix; the diagonal entries are the invariant
    # factors. Zero invariant factors (free part) give factor 0 → infinite
    # cokernel. We expect cokernel to be finite (since B's row space
    # contains D_H rows, which generate a full-rank Z^N sublattice).
    factors := [];
    for k_G in [1..Minimum(Length(snf), N)] do
        if snf[k_G][k_G] = 0 then
            Error("ImageOrder: SNF has zero invariant factor - infinite ",
                  "cokernel. Did D_H rows make it into the matrix?");
        fi;
        Add(factors, snf[k_G][k_G]);
    od;
    return Product(T_H) / Product(factors);
end;;

KernelOrder := function(data, ea_indices, include_D8, include_Q8)
    local rec_M, image_order, group_order;
    rec_M := BuildFamilyM(data, ea_indices, include_D8, include_Q8);
    image_order := ImageOrder(rec_M.M, rec_M.T_H);
    group_order := Product(data.torsion_G);
    return group_order / image_order;
end;;

# Helper: convert ea_indices + flags to a label string.
FamilyLabel := function(ea_indices, include_D8, include_Q8)
    local s;
    s := Concatenation("EA=", String(ea_indices));
    if include_D8 then s := Concatenation(s, "+D8"); fi;
    if include_Q8 then s := Concatenation(s, "+Q8"); fi;
    return s;
end;;

# ---------------------------------------------------------------------
# m=2 cross-check vs brute-force enumeration (above showed 3 EAs + D_8 +
# Q_8 suffices; smaller fails).
# ---------------------------------------------------------------------

_outfile := "/tmp/minimal_family_154_snf.out";;
_stream  := OutputTextFile(_outfile, false);;
SetPrintFormattingStatus(_stream, false);;

PrintTo(_stream, "# SNF-based kernel-order computation for minimal family\n");
PrintTo(_stream, "# Date: 2026-05-20\n\n");

# --- m=2 sanity check ---
Print("Loading m=2...\n");
_data2 := BuildRestrictionMatrices(2, "hap");;
PrintTo(_stream, "## m=2 sanity (cross-check against brute force)\n");
PrintTo(_stream, "# |H^3(G; U(1))| = ", Product(_data2.torsion_G), "\n");
PrintTo(_stream, "# Expected (from brute force):\n");
PrintTo(_stream, "#   {EA[3]} only: |ker| = 256\n");
PrintTo(_stream, "#   {EA[3], D8, Q8}: |ker| = 16\n");
PrintTo(_stream, "#   {EA[1], EA[4], EA[6], D8, Q8}: |ker| = 1 (INJECTIVE)\n");
PrintTo(_stream, "#   Full 6 EAs + D8 + Q8: |ker| = 1\n\n");

_pre := "\n";
PrintTo(_stream, "  {EA[3]} only: SNF |ker| = ",
        KernelOrder(_data2, [3], false, false), "\n");
PrintTo(_stream, "  {EA[3], D8, Q8}: SNF |ker| = ",
        KernelOrder(_data2, [3], true, true), "\n");
PrintTo(_stream, "  {EA[1], EA[4], EA[6], D8, Q8}: SNF |ker| = ",
        KernelOrder(_data2, [1, 4, 6], true, true), "\n");
PrintTo(_stream, "  Full 6 EAs + D8 + Q8: SNF |ker| = ",
        KernelOrder(_data2, [1, 2, 3, 4, 5, 6], true, true), "\n\n");

# --- m=2 full subset enumeration via SNF (much faster than brute force) ---
PrintTo(_stream, "## m=2 subset enumeration (SNF)\n");
PrintTo(_stream, "## subset | with-D8+Q8 |ker| | EA-only |ker|\n");
for _k in [0..6] do
    for _S in Combinations([1..6], _k) do
        _kerDQ := KernelOrder(_data2, _S, true, true);
        _kerEA := KernelOrder(_data2, _S, false, false);
        if _kerDQ = 1 or _kerEA = 1 then
            PrintTo(_stream, "  ", _S, "  k=", _k,
                    "  ker(EA+D8+Q8)=", _kerDQ,
                    "  ker(EA only)=", _kerEA, "\n");
        fi;
    od;
od;
PrintTo(_stream, "\n");

# --- m=3 subset enumeration ---
Print("Loading m=3...\n");
_data3 := BuildRestrictionMatrices(3, "hap");;
PrintTo(_stream, "## m=3 (k_G = ", Length(_data3.torsion_G),
        ", n_EA = ", Length(_data3.H_EA_list),
        ", |H^3(G; U(1))| = ", Product(_data3.torsion_G), ")\n\n");

# Baseline: full 30 EAs + D8 + Q8
PrintTo(_stream, "## m=3 baseline (full N_+(3,2)=30 EAs + D8 + Q8)\n");
_full3 := KernelOrder(_data3, [1..30], true, true);
PrintTo(_stream, "  ker = ", _full3, "  (expected 1 = injective)\n\n");

# Greedy minimal cover gave {EA[2], EA[13]}. Test with D8+Q8.
PrintTo(_stream, "## m=3 greedy-cover candidate {EA[2], EA[13]}\n");
PrintTo(_stream, "  EA only:      ker = ",
        KernelOrder(_data3, [2, 13], false, false), "\n");
PrintTo(_stream, "  EA + D8 + Q8: ker = ",
        KernelOrder(_data3, [2, 13], true, true), "\n\n");

# Test a sample of pairs (the 25 that gave full per-gen coverage).
PrintTo(_stream, "## m=3 size-2 EA + {D8, Q8} subsets (sample)\n");
_sample_pairs := [[2,13], [3,20], [3,21], [5,13], [6,13], [13,20], [13,28], [13,29]];
for _S in _sample_pairs do
    PrintTo(_stream, "  ", _S, "  ker(EA+D8+Q8) = ",
            KernelOrder(_data3, _S, true, true), "\n");
od;
PrintTo(_stream, "\n");

# Test larger systematic samples: size 1, 2, ..., 6.
# (For larger sizes the search space is enormous so we only spot-check.)
PrintTo(_stream, "## m=3: minimum EA-family size for injectivity (with D8+Q8)\n");
# Size 1: 30 subsets.
_min_size_dq := fail;
_examples := [];
for _k in [0..6] do
    for _S in Combinations([1..30], _k) do
        if KernelOrder(_data3, _S, true, true) = 1 then
            if _min_size_dq = fail then
                _min_size_dq := _k;
                Add(_examples, _S);
                if Length(_examples) >= 5 then break; fi;
            elif _k = _min_size_dq then
                Add(_examples, _S);
                if Length(_examples) >= 5 then break; fi;
            fi;
        fi;
    od;
    if _min_size_dq <> fail and Length(_examples) >= 5 then break; fi;
    if _min_size_dq <> fail then break; fi;  # found minimum at size k
od;
PrintTo(_stream, "# Min |F_EA| (with D8, Q8) = ",
        If_(_min_size_dq = fail, "not found in [0..6]", String(_min_size_dq)),
        "\n");
PrintTo(_stream, "# Examples: ", _examples, "\n\n");

# Same without D_8 / Q_8: pure EA-only.
PrintTo(_stream, "## m=3: minimum EA-only family for injectivity\n");
PrintTo(_stream, "# (At m=2 NONE of the 63 EA-only subsets worked, even all 6 EAs.\n");
PrintTo(_stream, "# At m=3, with 30 EAs, we sample small subsets.)\n");
_min_size_ea := fail;
_examples_ea := [];
for _k in [0..6] do
    for _S in Combinations([1..30], _k) do
        if KernelOrder(_data3, _S, false, false) = 1 then
            if _min_size_ea = fail then
                _min_size_ea := _k;
                Add(_examples_ea, _S);
                if Length(_examples_ea) >= 5 then break; fi;
            elif _k = _min_size_ea then
                Add(_examples_ea, _S);
                if Length(_examples_ea) >= 5 then break; fi;
            fi;
        fi;
    od;
    if _min_size_ea <> fail and Length(_examples_ea) >= 5 then break; fi;
    if _min_size_ea <> fail then break; fi;
od;
PrintTo(_stream, "# Min |F_EA| (EA only) in [0..6] = ",
        If_(_min_size_ea = fail, "not found", String(_min_size_ea)),
        "\n");
PrintTo(_stream, "# Examples: ", _examples_ea, "\n\n");

CloseStream(_stream);
Print("Wrote ", _outfile, "\n");
QUIT_GAP(0);
