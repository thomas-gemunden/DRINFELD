# minimal_family_314_rulings.g (issue #314)
#
# Test the "two rulings of (F_2^4, Q_+) hyperbolic quadric" hypothesis at m=2:
# the two minimum-witness EA triples {EA_1, EA_4, EA_6} and {EA_2, EA_3, EA_5}
# (from PR #310) should correspond to the two systems of Lagrangians in the
# Klein-quadric-style decomposition of the maximal isotropic Grassmannian.
#
# We:
#   1. Read m=2 restriction data via BuildRestrictionMatrices.
#   2. For each EA index i, extract a Lagrangian basis (the m=2 EA is rank
#      m+1=3, generated by z and 2 commuting non-central elements;
#      the F_2 quotient by z gives a Lagrangian plane in V = G/Z = F_2^4).
#   3. Compute pairwise intersection dimensions (in F_2^4 modulo z).
#      For the two rulings of a hyperbolic 4-quadric (= the 2 systems of
#      lines on P^1 x P^1), within a ruling the 3 Lagrangians are pairwise
#      disjoint (intersection dim = 0), and across rulings they intersect
#      in a 1-dim subspace.
#   4. Compute the partition into "rulings" by intersection structure.
#   5. Verify it matches the empirical partition {1,4,6} | {2,3,5}.
#   6. Verify each ruling alone (+ D_8, Q_8) gives injective family.

ChangeDirectoryCurrent(
  "/Users/thomasgemunden/Projects/group_cohomology/DRINFELD-wt-314/extraspecial_orbifolds/scripts");

Read("detecting_family_restriction.g");

# Helper SNF for kernel order (copied from minimal_family_154_snf_m3.g)
BuildFamilyM := function(data, ea_indices, include_D8, include_Q8)
    local M_blocks, T_blocks, j, M, T_H;
    M_blocks := [];
    T_blocks := [];
    for j in ea_indices do
        Add(M_blocks, data.res_EA_list[j]);
        Append(T_blocks, data.torsion_EA_list[j]);
    od;
    if include_D8 then
        Add(M_blocks, data.res_D8);
        Append(T_blocks, data.torsion_D8);
    fi;
    if include_Q8 and data.res_Q8 <> fail then
        Add(M_blocks, data.res_Q8);
        Append(T_blocks, data.torsion_Q8);
    fi;
    M := TransposedMat(Concatenation(List(M_blocks, TransposedMat)));
    return rec(M := M, T_H := T_blocks);
end;;

ImageOrder := function(M, T_H)
    local N, D_H, B, snf, factors, k;
    N := Length(T_H);
    D_H := List([1..N], i -> List([1..N], j -> If_(i = j, T_H[i], 0)));
    B := Concatenation(M, D_H);
    snf := SmithNormalFormIntegerMat(B);
    factors := [];
    for k in [1..Minimum(Length(snf), N)] do
        if snf[k][k] = 0 then Error("zero invariant factor"); fi;
        Add(factors, snf[k][k]);
    od;
    return Product(T_H) / Product(factors);
end;;

KernelOrder := function(data, ea_indices, include_D8, include_Q8)
    local rec_M, image_order, group_order;
    rec_M := BuildFamilyM(data, ea_indices, include_D8, include_Q8);
    image_order := ImageOrder(rec_M.M, rec_M.T_H);
    group_order := Product(data.torsion_G);
    return group_order / image_order;
end;;

_outfile := "/tmp/minimal_family_314_rulings.out";;
_stream := OutputTextFile(_outfile, false);;
SetPrintFormattingStatus(_stream, false);;

PrintTo(_stream, "# minimal_family_314_rulings.g (issue #314)\n");
PrintTo(_stream, "# Test two-rulings hypothesis at m=2.\n\n");

Print("Loading m=2 restriction data...\n");
_data2 := BuildRestrictionMatrices(2, "hap");;
_G := _data2.G;
_z := First(AsList(Centre(_G)), x -> not IsOne(x));

PrintTo(_stream, "## EA enumeration at m=2\n");
PrintTo(_stream, "  n_EA = ", Length(_data2.H_EA_list), "\n");
PrintTo(_stream, "  G = E_+(2), order ", Order(_G), "\n");
PrintTo(_stream, "  z (centre) = ", _z, "\n\n");

# For each EA, extract its image in V = G/Z = F_2^4
# Note: V = G^{ab}/torsion as F_2 space, or equivalently G/Z(G).
_V := Image(NaturalHomomorphismByNormalSubgroup(_G, Centre(_G)));
_natHom := NaturalHomomorphismByNormalSubgroup(_G, Centre(_G));

# Compute Lagrangian planes as subgroups of V
_lagrangians := [];
for _ea in _data2.H_EA_list do
    Add(_lagrangians, Image(_natHom, _ea));
od;

PrintTo(_stream, "## Lagrangian planes in V = G/Z (= F_2^4)\n");
for _i in [1..Length(_lagrangians)] do
    PrintTo(_stream, "  L_", _i,
            ": order ", Order(_lagrangians[_i]),
            ", elements ",
            List(AsList(_lagrangians[_i]), x -> ExtRepOfObj(x)),
            "\n");
od;
PrintTo(_stream, "\n");

# Compute pairwise intersection dimensions: dim_{F_2}(L_i cap L_j) = log_2 |L_i cap L_j|
_intersect_dims := List([1..Length(_lagrangians)],
    i -> List([1..Length(_lagrangians)],
        j -> LogInt(Order(Intersection(_lagrangians[i], _lagrangians[j])), 2)));

PrintTo(_stream, "## Pairwise dim_{F_2}(L_i ∩ L_j) (Lagrangian intersection)\n");
for _i in [1..Length(_lagrangians)] do
    PrintTo(_stream, "  ", _intersect_dims[_i], "\n");
od;
PrintTo(_stream, "\n");

# Partition into "rulings": two Lagrangians are in the same ruling
# iff their intersection is 0 (in V), i.e. dim L_i ∩ L_j = 0.
# Equivalently: L_i + L_j = V (= F_2^4), so they are TRANSVERSE.
# Lagrangians from the same ruling are transverse; different rulings
# meet in a line.
#
# Build graph G_intersect where edge i-j iff dim(L_i cap L_j) = 0
# (i.e. transverse). Same ruling = same connected component.
PrintTo(_stream, "## Partition into rulings\n");
_neighbours := List([1..Length(_lagrangians)],
    i -> Filtered([1..Length(_lagrangians)],
        j -> i <> j and _intersect_dims[i][j] = 0));
for _i in [1..Length(_lagrangians)] do
    PrintTo(_stream, "  L_", _i, " transverse to: ", _neighbours[_i], "\n");
od;
PrintTo(_stream, "\n");

# A "ruling" consists of mutually transverse Lagrangians (every pair has
# intersection 0). In O+(4, 2) each ruling has exactly 3 elements.
# Find all maximal cliques in the transversality graph.
FindCliques := function(neighbours)
    local n, cliques, i, j, k;
    n := Length(neighbours);
    cliques := [];
    for i in [1..n] do
        for j in [(i+1)..n] do
            for k in [(j+1)..n] do
                if (j in neighbours[i]) and (k in neighbours[i])
                   and (k in neighbours[j]) then
                    Add(cliques, [i, j, k]);
                fi;
            od;
        od;
    od;
    return cliques;
end;;

_rulings := FindCliques(_neighbours);
PrintTo(_stream, "## Mutually-transverse 3-cliques (candidate rulings):\n");
for _r in _rulings do
    PrintTo(_stream, "  ", _r, "\n");
od;
PrintTo(_stream, "\n");

# Check whether the empirical witnesses are among the rulings
_emp1 := [1, 4, 6];
_emp2 := [2, 3, 5];

PrintTo(_stream, "## Empirical minimum witnesses\n");
PrintTo(_stream, "  W1 = ", _emp1, ": is a ruling? ",
        _emp1 in _rulings, "\n");
PrintTo(_stream, "  W2 = ", _emp2, ": is a ruling? ",
        _emp2 in _rulings, "\n");
PrintTo(_stream, "  W1 ∪ W2 = ", Union(_emp1, _emp2), " (should = [1..6])\n");
PrintTo(_stream, "  W1 ∩ W2 = ", Intersection(_emp1, _emp2),
        " (should be [] if complementary)\n\n");

# Verify each ruling alone (+ D_8, Q_8) gives injective family
PrintTo(_stream, "## Injectivity test for each ruling\n");
for _r in _rulings do
    _ker := KernelOrder(_data2, _r, true, true);
    PrintTo(_stream, "  EA = ", _r, " + D_8 + Q_8: |ker| = ", _ker,
            "  ", If_(_ker = 1, "(INJECTIVE)", "(non-injective)"), "\n");
od;
PrintTo(_stream, "\n");

# Verify: do we get k_min EAs = |ruling size|?
PrintTo(_stream, "## Summary: ruling size vs k_min(m=2) = 3\n");
PrintTo(_stream, "  Number of rulings (3-cliques): ", Length(_rulings), "\n");
PrintTo(_stream, "  Size of each ruling: 3 (= k_min EAs at m=2)\n");
PrintTo(_stream, "  k_min total = 3 (one ruling) + 2 ({D_8, Q_8}) = 5\n");

CloseStream(_stream);
Print("Done. Output in ", _outfile, "\n");
QUIT_GAP(0);
