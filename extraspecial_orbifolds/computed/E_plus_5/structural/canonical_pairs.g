  ("minus_one/sigma_1sigma_2/1/off") := [ 2, 5 ],
  ("sigma2/id/1/off") := [ 3, 1 ],
  ("sigma2/minus_one/1/off") := [ 3, 2 ],
  ("sigma2/sigma2/0/off") := [ 3, 4 ],
  ("sigma2/sigma2/1/diag") := [ 3, 3 ],
  ("sigma2/sigma2/1/off") := [ 3, 6 ],
  ("sigma2/sigma_1sigma_2/0/off") := [ 3, 5 ],
  ("sigma2/sigma_1sigma_2/1/off") := [ 3, 14 ],
