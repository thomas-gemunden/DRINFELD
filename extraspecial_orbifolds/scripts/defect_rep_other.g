# Port of section 7 of the Magma supplement (Keller-Roberts-Roberts,
# arXiv:2411.13646): defect representation for the non-(-1) conjugacy
# classes of E(m). The two relevant representatives are
#
#   g_2 = Sigma_{1,1}              (order 2, non-central)
#   g_4 = Sigma_{1,1} * Sigma_{1,2} (order 4)
#
# The construction follows section 2.3 of the paper. Given t in E(m)
# (in the unimodular representation), we form M = I - t and compute its
# Smith Normal Form  P*M*Q = D = diag(s_1, ..., s_n)  with s_i | s_{i+1}.
# The cokernel L / L(1-t) (with L = Z^{2^m}) is then
#
#   L / L(1-t) = direct-sum_i (Z / s_i Z),
#
# where the i-th summand is generated by [α_i] with α_i = (Q^-1)[i].
# (Magma uses the same convention; see Magma's SmithForm docs and the
# computation P[i]*M = s_i * α_i.)
#
# For the order-2 case (g_2 = Sigma_{1,1}), the SNF is
#   diag(2 * I_{2^{m-2}}, I_{2^{m-2}}, 0, ..., 0)
# and N = L_t^perp / L(1-t) = (Z/2)^{2^{m-2}}, generated by α_i for i in
# the 2-positions of the SNF.
#
# For the order-4 case (g_4 = Sigma_{1,1}*Sigma_{1,2}), the SNF is
#   diag(2*I_{2^{m-2}}, 2*I_{2^{m-2}}, I_{2^{m-2}}, I_{2^{m-2}})
# and N = (Z/2)^{2^{m-1}}.
#
# This file ports the Magma functions
#   SetupNTheta, BasisForNTheta, BasisForNS12,
#   NiceBasisForLS12, NiceBasisForL,
#   TwoCocycleForNTheta, TwoCocycleForNS12,
#   TwoCocycleForNThetaOfa, TwoCocycleForNOfS12, DeltaHNTheta
# from lines 1320-1426 of BWOrbifoldsMagma.txt.
#
# The cocycle helpers are ported but the principal computational result
# (per the paper) is that the centralizers C_{E(m)}(g_2) and C_{E(m)}(g_4)
# act *trivially* on N for m = 3, 5, 7. Verification of this is done in
# test_defect_rep_other.g.

Read("bw_lattice.g");        # supplies BWGram, HalfGram, BitsOf, Parity
Read("em_construction.g");   # supplies Sigma_ar, ZGen, EmGroup, TensorList
Read("twisted_group_algebra.g");  # supplies UnimodSigma, UnimodZ, LowerStrict, Bg

# ZOTPositions: locate diagonal entries of D that are 0, 1, 2.
# Returns [zeros, ones, twos] each a list of 1-based indices.
# (Magma's ZOT, lines 17-39 of the source.)
ZOTPositions := function(D)
    local zeros, ones, twos, i;
    zeros := []; ones := []; twos := [];
    for i in [1..Length(D)] do
        if   D[i][i] = 0 then Add(zeros, i);
        elif D[i][i] = 1 then Add(ones, i);
        elif D[i][i] = 2 then Add(twos, i);
        fi;
    od;
    return rec(zeros := zeros, ones := ones, twos := twos);
end;;

# SetupNTheta: given t in E(m)'s unimodular representation, compute the
# Smith Normal Form of (I - t) and return three lists of basis vectors:
#   R1 = rows of Q^-1 indexed by 2-positions of SNF (generators of N)
#   R2 = rows of Q^-1 indexed by 1-positions of SNF (in L(1-t))
#   R3 = rows of Q^-1 indexed by 0-positions of SNF (free part)
# (Magma's SetupNTheta, lines 1322-1340 of the source.)
#
# Returns a record with fields R1, R2, R3, plus:
#   D            - the SNF diagonal matrix
#   Qinv         - Q^-1 (whose rows are α_i in paper's notation)
#   positions    - record(zeros, ones, twos)
SetupNTheta := function(t)
    local n, M, sf, Q, D, Qinv, pos, R1, R2, R3, i;
    n := Length(t);
    M := IdentityMat(n) - t;
    sf := SmithNormalFormIntegerMatTransforms(M);
    # sf.rowtrans * M * sf.coltrans = sf.normal, i.e. P * M * Q = D
    Q := sf.coltrans;
    D := sf.normal;
    Qinv := Q^-1;
    pos := ZOTPositions(D);
    R1 := List(pos.twos,  i -> Qinv[i]);
    R2 := List(pos.ones,  i -> Qinv[i]);
    R3 := List(pos.zeros, i -> Qinv[i]);
    return rec(R1 := R1, R2 := R2, R3 := R3,
               D := D, Qinv := Qinv, Q := Q, positions := pos);
end;;

# Helper: nullspace of a list of row vectors over GF(2) (each entry an
# integer; we reduce mod 2). Returns a list of basis row vectors of the
# orthogonal complement.

# Helper: rank over GF(2).
RankOverGF2 := function(M)
    local Mf;
    Mf := List(M, row -> List(row, x -> x * Z(2)^0));
    return RankMat(Mf);
end;;

# Helper: compute a symplectic basis for an alternating bilinear form B
# (matrix over Z, taken mod 2) on F_2^d. Returns a (d-by-d) integer
# matrix L such that L*B*L^T (mod 2) is the standard symplectic form
#   [[0, I], [I, 0]] (modulo 2).
# (For our use case the form will be non-degenerate of even rank.)
#
# Algorithm: standard greedy pairing. We maintain a working set of basis
# vectors {v_1, ..., v_k}, find a hyperbolic pair, peel it off, recurse.
SymplecticBasisGF2 := function(B)
    local d, V, F, A, e_paired, f_paired, i, j, ipair, jpair, vi, vj,
          val, found, pivot, k, used, results, e_list, f_list, v;
    d := Length(B);
    if d = 0 then return []; fi;
    # Reduce B mod 2.
    A := List(B, row -> List(row, x -> x mod 2));
    # Working basis as identity (we track each basis vector's coefficients
    # in the original basis as a row of V).
    V := IdentityMat(d);
    e_list := [];
    f_list := [];
    used := List([1..d], i -> false);
    while true do
        # Find a vector in the working basis (those with used[i]=false)
        # that is non-isotropic w.r.t. some other unused vector.
        ipair := 0;  jpair := 0;
        for i in [1..d] do
            if used[i] then continue; fi;
            for j in [1..d] do
                if used[j] or j = i then continue; fi;
                # Compute V[i] * A * V[j]^T mod 2.
                val := (V[i] * A * V[j]) mod 2;
                if val = 1 then ipair := i; jpair := j; break; fi;
            od;
            if ipair > 0 then break; fi;
        od;
        if ipair = 0 then break; fi;  # done — remaining are radical
        # Take e = V[ipair], f = V[jpair]. Make all other unused vectors
        # symplectic-orthogonal to e and f.
        for k in [1..d] do
            if used[k] or k = ipair or k = jpair then continue; fi;
            # adjust V[k] to be orthogonal to e (= V[ipair]) and f (= V[jpair])
            # i.e. <V[k], V[ipair]> = 0 and <V[k], V[jpair]> = 0.
            # Currently <V[k], V[jpair]> = (V[k]*A*V[jpair]) mod 2.
            # To zero out, subtract (that scalar) * V[ipair].
            val := (V[k] * A * V[jpair]) mod 2;
            if val = 1 then V[k] := List(V[k] + V[ipair], x -> x mod 2); fi;
            val := (V[k] * A * V[ipair]) mod 2;
            if val = 1 then V[k] := List(V[k] + V[jpair], x -> x mod 2); fi;
        od;
        Add(e_list, V[ipair]);
        Add(f_list, V[jpair]);
        used[ipair] := true;
        used[jpair] := true;
    od;
    # Concatenate: e_1, ..., e_g, f_1, ..., f_g, then the radical.
    return Concatenation(e_list, f_list,
                         List(Filtered([1..d], i -> not used[i]), i -> V[i]));
end;;

# BasisForNTheta(t): symplectic basis of N = L_t^perp / L(1-t) for an
# order-2 element t. Returns an integer matrix whose rows are basis
# vectors in L (representatives of cosets in N), of total length |R1|.
# (Magma's BasisForNTheta, lines 1342-1353.)
BasisForNTheta := function(t)
    local m, setup, R1mat, G, formMod2, L;
    m := LogInt(Length(t), 2);
    setup := SetupNTheta(t);
    R1mat := setup.R1;
    if Length(R1mat) = 0 then
        return [];
    fi;
    G := BWGram(m);
    # Form on N: R1 * G * R1^T mod 2.
    formMod2 := List(R1mat * G * TransposedMat(R1mat),
                     row -> List(row, x -> x mod 2));
    L := SymplecticBasisGF2(formMod2);
    return L * R1mat;
end;;

# BasisForNS12(t): symplectic basis of N for an order-4 element of the
# form Sigma_{1,1}*Sigma_{1,2}. The form on N uses (t + I) instead of
# the bare Gram (this comes from C(α, β) for n = 4).
# (Magma's BasisForNS12, lines 1355-1367.)
BasisForNS12 := function(t)
    local m, n, setup, R1mat, G, twist, formMod2, L;
    m := LogInt(Length(t), 2);
    n := 2^m;
    setup := SetupNTheta(t);
    R1mat := setup.R1;
    if Length(R1mat) = 0 then
        return [];
    fi;
    G := BWGram(m);
    twist := t + IdentityMat(n);
    formMod2 := List(R1mat * twist * G * TransposedMat(R1mat),
                     row -> List(row, x -> x mod 2));
    L := SymplecticBasisGF2(formMod2);
    return L * R1mat;
end;;

# NiceBasisForL(t): a basis of L (as Z-module) such that the first
# rows form a symplectic basis of N_θ; the next block (rows from R2)
# is the SNF 1-positions; the last block (R3) is the SNF 0-positions.
# (Magma's NiceBasisForL, lines 1374-1377.)
NiceBasisForL := function(t)
    local setup, basisN;
    setup := SetupNTheta(t);
    basisN := BasisForNTheta(t);
    return Concatenation(basisN, setup.R2, setup.R3);
end;;

# NiceBasisForLS12(t): same idea, for Sigma_{1,1}*Sigma_{1,2}.
# (Magma's NiceBasisForLS12, lines 1369-1372.)
NiceBasisForLS12 := function(t)
    local setup, basisN;
    setup := SetupNTheta(t);
    basisN := BasisForNS12(t);
    return Concatenation(basisN, setup.R2);
end;;

# TwoCocycleForNTheta(t): the 2-cocycle for N (order-2 case),
# obtained from R1*Gram*R1^T mod 2 with the lower-triangle block
# zeroed (the "skew" trick from section 4.2 of the paper).
# (Magma's TwoCocycleForNTheta, lines 1380-1388.)
TwoCocycleForNTheta := function(t)
    local m, basisN, G, mat, half, i, j;
    m := LogInt(Length(t), 2);
    basisN := BasisForNTheta(t);
    if Length(basisN) = 0 then return []; fi;
    G := BWGram(m);
    mat := List(basisN * G * TransposedMat(basisN),
                row -> List(row, x -> x mod 2));
    half := QuoInt(Length(mat), 2);
    for i in [1..half] do
        mat[half + i][i] := 0;
    od;
    return mat;
end;;

# TwoCocycleForNS12(t): the 2-cocycle for N (order-4 case).
# (Magma's TwoCocycleForNS12, lines 1390-1399.)
TwoCocycleForNS12 := function(t)
    local m, n, basisN, G, twist, mat, half, i;
    m := LogInt(Length(t), 2);
    n := 2^m;
    basisN := BasisForNS12(t);
    if Length(basisN) = 0 then return []; fi;
    G := BWGram(m);
    twist := t + IdentityMat(n);
    mat := List(basisN * twist * G * TransposedMat(basisN),
                row -> List(row, x -> x mod 2));
    half := QuoInt(Length(mat), 2);
    for i in [1..half] do
        mat[half + i][i] := 0;
    od;
    return mat;
end;;

# TwoCocycleForNThetaOfa(t, a): the 2-cocycle modified by a (order-2 case).
# (Magma's TwoCocycleForNThetaOfa, lines 1401-1409.)
TwoCocycleForNThetaOfa := function(t, a)
    local m, B, b, conj, A, G, sub, i;
    m := LogInt(Length(a), 2);
    B := NiceBasisForL(t);
    b := BasisForNTheta(t);
    if Length(b) = 0 then return []; fi;
    conj := List(B * a * (B^-1), row -> List(row, x -> x mod 2));
    A := List([1..Length(b)], i -> conj[i]{[1..Length(b)]});
    G := TwoCocycleForNTheta(t);
    return List(A * G * TransposedMat(A), row -> List(row, x -> x mod 2));
end;;

# TwoCocycleForNOfS12(t, a): same, for Sigma_{1,1}*Sigma_{1,2}.
# (Magma's TwoCocycleForNOfS12, lines 1411-1419.)
TwoCocycleForNOfS12 := function(t, a)
    local m, B, b, conj, A, G, i;
    m := LogInt(Length(a), 2);
    B := NiceBasisForLS12(t);
    b := BasisForNS12(t);
    if Length(b) = 0 then return []; fi;
    conj := List(B * a * (B^-1), row -> List(row, x -> x mod 2));
    A := List([1..Length(b)], i -> conj[i]{[1..Length(b)]});
    G := TwoCocycleForNS12(t);
    return List(A * G * TransposedMat(A), row -> List(row, x -> x mod 2));
end;;

# DeltaHNTheta(t, a): a 2-coboundary for the sum of the two cocycles.
# (Magma's DeltaHNTheta, lines 1422-1424.) Returns the upper-triangular
# part of (TwoCocycleForNTheta(t) + TwoCocycleForNThetaOfa(t,a)) — this
# is "Transpose(LowerTriangularize(...))" in Magma.
DeltaHNTheta := function(t, a)
    local sum, n, R, i, j;
    sum := List([1..Length(TwoCocycleForNTheta(t))],
                i -> TwoCocycleForNTheta(t)[i] + TwoCocycleForNThetaOfa(t, a)[i]);
    n := Length(sum);
    R := List([1..n], i -> List([1..n], j -> 0));
    for i in [1..n] do
        for j in [i+1..n] do
            R[i][j] := sum[i][j] mod 2;
        od;
    od;
    return R;
end;;

# --- The main verification function ---
#
# CentralizerActsTriviallyOnN(t, group, isOrder4):
#   t        - an order-2 (or order-4) element of E(m) in the unimodular rep.
#   group    - either GeneratorsOfGroup(C) or all elements of C, i.e. a
#              list of matrices to test.
#   isOrder4 - true if t is the order-4 representative (g_4); ignored
#              currently because the structural check (action on cosets)
#              is the same, only the F_2 form differs.
#
# Returns a record(allTrivial, fails, totalChecked) where fails is a
# list of [h, problemDescription] for any h that acts non-trivially.
#
# Algorithm: a basis vector α_i for i in 2-positions of SNF generates
# a Z/2 summand of L / L(1-t). h sends α_i to (some Z-linear combo of
# α_j). For h to act trivially on N = (Z/2)^d (the torsion subgroup
# inside L_t^perp / L(1-t)):
#   - For j in 1-positions: any coefficient is OK (α_j = 0 in cokernel).
#   - For j in 2-positions: coefficient must equal δ_{ij} mod 2.
#   - For j in 0-positions: coefficient must be 0 (otherwise the image
#     leaves the torsion subgroup, contradicting h preserving L_t^perp).
CentralizerActsTriviallyOnN := function(t, hList)
    local setup, Qinv, Q, pos, twos, ones, zeros, fails, count, h, H,
          ok, i, j;
    setup := SetupNTheta(t);
    Qinv := setup.Qinv;
    Q := setup.Q;     # = Qinv^{-1}
    pos := setup.positions;
    twos := pos.twos;
    ones := pos.ones;
    zeros := pos.zeros;
    fails := [];
    count := 0;
    for h in hList do
        H := Qinv * h * Q;   # row i of H = α_i * h written in {α_j} basis
        ok := true;
        for i in twos do
            for j in zeros do
                if H[i][j] <> 0 then
                    ok := false;
                    Add(fails, rec(elt := h, i := i, j := j,
                                   reason := "nonzero entry in 0-position",
                                   value := H[i][j]));
                fi;
            od;
            for j in twos do
                if i = j then
                    if (H[i][j] - 1) mod 2 <> 0 then
                        ok := false;
                        Add(fails, rec(elt := h, i := i, j := j,
                                       reason := "diagonal not 1 mod 2",
                                       value := H[i][j]));
                    fi;
                else
                    if H[i][j] mod 2 <> 0 then
                        ok := false;
                        Add(fails, rec(elt := h, i := i, j := j,
                                       reason := "off-diagonal not 0 mod 2",
                                       value := H[i][j]));
                    fi;
                fi;
            od;
        od;
        count := count + 1;
    od;
    return rec(allTrivial := Length(fails) = 0,
               fails      := fails,
               totalChecked := count);
end;;
