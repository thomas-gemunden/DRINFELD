# test_epsilon_omega.g — V-1 acceptance tests for `EpsilonOmega`.
#
# Tests:
#   (1) ε_ω ≡ 0 (mod m) on a sample of G^4 tuples when ω = 0
#       (the trivial cocycle).  ⟹  E(m)^0 = 1 phase, as required.
#
#   (2) For G = Q_8 = SmallGroup(8, 4), with the order-2 cocycle (orbit
#       index 2 in modular_data/8/4/), reproduce 10 central-row S-matrix
#       entries via the closed-form §6.2 formula using `EpsilonOmega`,
#       and assert byte-for-byte equality against modular_data/8/4/2.txt
#       up to a per-block permutation σ of the simples.
#
# Run: gap test_epsilon_omega.g  (from the scripts/tests/ directory) or
#      Read("extraspecial_orbifolds/scripts/tests/test_epsilon_omega.g");
# All paths below are absolute so cwd is irrelevant.
#
# Convention drift note (documented deviation from byte-for-byte):
# ----------------------------------------------------------------------
# The disk file modular_data/8/4/2.txt was generated by `sVal` in
# modular_data.g, which produces the *same* S-matrix as our
# `EpsilonOmega`-routed computation but with simple objects in a
# different order *within each conjugacy-class block*.  Specifically:
#
#   * Within block 2 (g_1 = f1, the 4 projective 1D characters), our
#     enumeration has T-diagonal [1, -E(4), -1, E(4)] whereas the disk
#     file has [1, -1, E(4), -E(4)]; one is the other under the
#     permutation (2 3 4) ↦ (3 4 2) within that block.
#   * Same story for block 3 (g_1 = f2) and block 5 (g_1 = f1*f2).
#   * Block 4 (g_1 = f3, the central 4 + 1 projective characters): the
#     four 1D projective characters can be relabelled by (1 4) within
#     that block — they correspond to four different sign-choices of the
#     underlying 1D irreps of `C_G(f3) = G`, and the labelling depends
#     on GAP's `Irr` enumeration.
#
# The full block-respecting permutation that takes our enumeration to
# the disk enumeration is
#
#   σ = [1, 2, 3, 4, 5, 6, 8, 9, 7, 10, 12, 13, 11,
#        17, 15, 16, 14, 18, 19, 21, 20, 22]
#
# After applying σ to both rows and columns of our computed S, the
# matrix matches the disk file byte-for-byte (all 22*22 = 484 entries).
# This is documented evidence that `EpsilonOmega` reproduces the disk
# S-matrix up to the canonical (non-)choice of projective character
# labelling.
#
# The test below builds σ by canonicalising the T-diagonal in each block
# (since within each f1/f2/f1*f2 block the T values are distinct) and
# then searches for the right permutation in the central f3 block by
# 4! = 24 trials.  Once σ is found, we verify equality on 10 central
# rows.

LoadPackage("hap");
LoadPackage("io");

# Pull in the existing modular_data.g machinery (StandardCocycle, the
# UCT helper, GenerateSimpleObjects, ConjugacyClasses helpers, etc.):
Read("/Users/thomasgemunden/Projects/group_cohomology/DRINFELD-wt-v1/src/modular_data.g");
Read("/Users/thomasgemunden/Projects/group_cohomology/DRINFELD-wt-v1/extraspecial_orbifolds/scripts/epsilon_omega.g");

############################################################
# (1) Trivial-cocycle case.
############################################################

TestEpsilonOmegaTrivial := function()
    local G, elts, zero_omega, m, count, fails, tuple_count, i, g1, g2, a, b, val;
    G := SmallGroup(8, 4);   # Q_8 — pick a non-abelian group for a stronger test.
    elts := AsList(G);
    # Trivial cocycle: ω(g, h, k) = 0 for all g, h, k. Pick m = 8 (a
    # plausible Z/m exponent for Q_8's H^3 = Z/8).
    zero_omega := function(g, h, k) return 0; end;
    m := 8;

    # Sample ~50 random G^4 tuples (deterministic seed for reproducibility).
    Reset(GlobalMersenneTwister, 12345);
    fails := 0;
    tuple_count := 50;
    for i in [1..tuple_count] do
        g1 := Random(GlobalMersenneTwister, elts);
        g2 := Random(GlobalMersenneTwister, elts);
        # For ε_ω callability we need a in [g1] and b in [g2]; pick a
        # random conjugate of each:
        a  := Random(GlobalMersenneTwister, ConjugacyClass(G, g1));
        b  := Random(GlobalMersenneTwister, ConjugacyClass(G, g2));
        val := EpsilonOmega(G, zero_omega, g1, g2, a, b, m);
        if val <> 0 then
            fails := fails + 1;
            Print("  FAIL: trivial-ω tuple (", g1, ", ", g2, ", ", a, ", ",
                  b, ") returned ", val, " (expected 0)\n");
        fi;
    od;
    if fails > 0 then
        Error("Trivial-cocycle test: ", fails, "/", tuple_count, " failures.");
    fi;
    Print("  PASS: trivial-ω test (", tuple_count, " tuples, all ε_ω = 0 mod ", m, ")\n");
end;;

############################################################
# (2) Q_8 byte-for-byte match against modular_data/8/4/2.txt
#     (up to per-block permutation σ of simples).
############################################################
# Strategy:
# Reproduce the simples list and S-matrix that modular_data.g would
# produce for SmallGroup(8, 4) with cocycle vector [0, 4, 0] (orbit 2).
# Build the full S-matrix via the §6.2 closed-form using our public
# `EpsilonOmegaWithSection`.  Find a block-respecting permutation σ
# such that the permuted S equals the on-disk S byte-for-byte.  Then
# verify that 10 central-row entries match under σ.
#
# Note on conventions: modular_data/8/4/2.txt, per modular_data/README,
# is `Z(Vec^{ω_2^{-1}})^{bop}`.  We do not invert / take bopposite —
# we just reproduce the exact computation `ComputeALittleData(8, 4, 2)`
# performs (which is what wrote the file).

# --------------------------------------------------------------------
# Inlined §6.3 closed-form S-entry evaluator (V-2 will package this).
#
# Reproduces sVal+CoefficientSSum from modular_data.g but routed through
# the public `EpsilonOmegaWithSection` callable, so a regression in
# `EpsilonOmega` breaks this test.  m_omega = cocycle.exp (the divisor
# of the integer values omega returns; see notes in epsilon_omega.g).
# --------------------------------------------------------------------
ComputeSEntryViaEpsilon := function(G, omega, val, exponent_with_val, gData, hData)
    local g1, g2, num, m_omega, ii, jj, a, b, ta, sb,
          eps_int, char_g1, char_g2;
    g1 := gData.representative;
    g2 := hData.representative;
    # In modular_data.g `omega` returns values in Z/(exponent*val) where
    # exponent = (cocycle.exp/val).  We use m = exponent*val = cocycle.exp.
    m_omega := exponent_with_val * val;
    num := 0;
    # gData.conjugacyClass is a list of pairs [a, ta] with
    # a = ta · g1 · ta^{-1}; same for hData.
    for ii in gData.conjugacyClass do
        for jj in hData.conjugacyClass do
            a  := ii[1]; ta := ii[2];
            b  := jj[1]; sb := jj[2];
            if a*b = b*a then
                eps_int := EpsilonOmegaWithSection(omega, g1, g2,
                                                   a, b, ta, sb, m_omega);
                # The phase is E(m_omega)^eps_int = E(exponent)^(eps_int/val)
                # exactly as in CoefficientSSum.
                char_g1 := LookupDictionary(gData.character, ta * b * ta^-1);
                char_g2 := LookupDictionary(hData.character, sb * a * sb^-1);
                num := num + E(m_omega)^eps_int * char_g1 * char_g2;
            fi;
        od;
    od;
    return ComplexConjugate(num) / Order(G);
end;;

# Build the full S-matrix via EpsilonOmegaWithSection for given simples.
ComputeFullSMatrixViaEpsilon := function(G, omega, val, exponent, simples)
    local n, S, i, j;
    n := Length(simples);
    S := NullMat(n, n);
    for i in [1..n] do
        for j in [1..n] do
            S[i][j] := ComputeSEntryViaEpsilon(G, omega, val, exponent,
                                                simples[i], simples[j]);
        od;
    od;
    return S;
end;;

# Find the per-block permutation σ that takes our enumeration of
# simples to the disk enumeration.  For Q_8 = SmallGroup(8, 4) with
# orbit 2, this exists and is the σ documented at the top of this file.
FindBlockPermutationQ8 := function(S_computed, S_disk, T_computed, T_disk)
    local n, blocks, sigma, block_id, perm_options, b, start, fin, perm1,
          perm4, candidate, S_perm, i, j, ok;
    n := Length(S_disk);
    # Block boundaries for Q_8 orbit 2:
    # [1..5] = identity, [6..9] = f1, [10..13] = f2,
    # [14..18] = f3, [19..22] = f1*f2.

    # Within blocks 2, 3, 5 (the f1, f2, f1*f2 blocks) the four T values
    # are distinct (1, -1, E(4), -E(4)); so the permutation is forced by
    # T_disk vs T_computed.
    # Within blocks 1 (identity) and 4 (f3), four T values are all 1 and
    # the 5th (the 2D irrep) is at position 5 / position 18 — uniquely
    # identifiable since it's the only dim-2 entry.

    # Block 2 (f1):
    perm_options := function(disk_pos_range, comp_pos_range)
        return List(disk_pos_range, i ->
            First(comp_pos_range, j -> T_computed[j] = T_disk[i]));
    end;

    sigma := [1, 2, 3, 4, 5];
    Append(sigma, perm_options([6..9], [6..9]));
    Append(sigma, perm_options([10..13], [10..13]));
    # Block 4: we'll fix positions 14-17 via a search, position 18 is the
    # 2D irrep (uniquely identifiable).
    Append(sigma, [14, 15, 16, 17]);   # placeholder
    Add(sigma, 18);
    Append(sigma, perm_options([19..22], [19..22]));

    # Search for the right permutation within block 4 by brute force
    # (24 perms).
    for perm4 in PermutationsList([14, 15, 16, 17]) do
        sigma{[14..17]} := perm4;
        S_perm := NullMat(n, n);
        for i in [1..n] do
            for j in [1..n] do
                S_perm[i][j] := S_computed[sigma[i]][sigma[j]];
            od;
        od;
        if S_perm = S_disk then
            return sigma;
        fi;
    od;
    return fail;
end;;

TestEpsilonOmegaQ8 := function()
    local G, R, K, UCT, cocycle_vec, val, exponent, omega,
          loaded, S_disk, T_disk, simples, simples_data, n_simples,
          S_computed, T_computed, sigma, central_idx, central_pairs,
          n_check, checked, mismatches, i, j, computed_entry, disk_entry,
          pair, i_disk, j_disk, i_comp, j_comp;
    G := SmallGroup(8, 4);   # Q_8

    # Reconstruct the cocycle ω corresponding to orbit 2.  The
    # 3-cocycles file says orbit 2 has vector [0, 4, 0] (with cocycle
    # exponent = exp(H^3(Q_8)) = 8).
    R := ResolutionFiniteGroup(G, 4);
    K := TensorWithIntegers(R);
    UCT := UniversalCoefficientsTheorem(K, 3);

    cocycle_vec := UCT.lift * [0, 4, 0];
    val := Gcd(Gcd(cocycle_vec), UCT.exponent);
    exponent := UCT.exponent / val;
    omega := StandardCocycle(R, cocycle_vec, 3, UCT.exponent);

    # Load existing modular data.
    loaded := ReadAsFunction(
        "/Users/thomasgemunden/Projects/group_cohomology/modular_data/8/4/2.txt")();
    S_disk := loaded.S;
    T_disk := loaded.T;

    # Build simples in the same way ComputeALittleData does.
    simples_data := GenerateSimpleObjects(G, omega, val, exponent);
    simples := simples_data.Simp;
    n_simples := Length(simples);
    Assert(0, n_simples = Length(S_disk),
           Concatenation("Simple count mismatch: built ", String(n_simples),
                         ", on disk ", String(Length(S_disk))));

    # Compute full S via EpsilonOmega.
    S_computed := ComputeFullSMatrixViaEpsilon(G, omega, val, exponent, simples);
    T_computed := List(simples,
        s -> LookupDictionary(s.character, s.representative) / s.dimension);

    # Sanity: T multisets must agree (cocycle reconstruction sanity).
    Assert(0, AsSortedList(T_disk) = AsSortedList(T_computed),
           "T-diagonal multisets disagree — cocycle reconstruction problem.");

    # Find the per-block permutation σ.
    sigma := FindBlockPermutationQ8(S_computed, S_disk, T_computed, T_disk);
    if sigma = fail then
        Error("No per-block permutation makes S_computed match S_disk. ",
              "EpsilonOmega may be wrong, OR the cocycle reconstruction ",
              "is for a different cohomology class.");
    fi;
    Print("  Found per-block sigma: ", sigma, "\n");

    # Sanity: verify the full matrix matches under sigma.
    for i in [1..n_simples] do
        for j in [1..n_simples] do
            Assert(0, S_computed[sigma[i]][sigma[j]] = S_disk[i][j],
                Concatenation("Full S mismatch at (", String(i), ", ",
                              String(j), ") after permutation."));
        od;
    od;
    Print("  Full S (484 entries) matches modular_data/8/4/2.txt under σ.\n");

    # Find indices of "central-row" simples (in disk numbering) —
    # those whose representative is in Z(Q_8) = {1, -1}.
    central_idx := Filtered([1..n_simples], i ->
        IsCentral(G, simples[sigma[i]].representative));

    # Pick 10 (i, j) pairs where i is a central simple (in disk numbering)
    # and j is anything.  Cover both g_1 = identity and g_1 = -1.
    central_pairs := [];
    # 4 picks with g_1 = identity:
    for pair in [[1, 1], [1, 5], [1, 14], [5, 18]] do
        if pair[1] in central_idx then
            Add(central_pairs, pair);
        fi;
    od;
    # 6 picks with g_1 = -1 (f3):
    for pair in [[14, 1], [14, 5], [14, 6], [14, 14],
                 [14, 18], [18, 18]] do
        if pair[1] in central_idx then
            Add(central_pairs, pair);
        fi;
    od;
    Assert(0, Length(central_pairs) >= 10,
           Concatenation("Not enough central-row pairs: have ",
                         String(Length(central_pairs))));

    # Compute each chosen entry via the §6.2 sum, using `EpsilonOmega`.
    # The computed entry is at (sigma[i], sigma[j]) in our numbering;
    # the disk entry is at (i, j) in disk numbering.
    mismatches := 0;
    checked := 0;
    for pair in central_pairs do
        i_disk := pair[1]; j_disk := pair[2];
        i_comp := sigma[i_disk]; j_comp := sigma[j_disk];
        computed_entry := ComputeSEntryViaEpsilon(G, omega, val, exponent,
                                                   simples[i_comp], simples[j_comp]);
        disk_entry := S_disk[i_disk][j_disk];
        if computed_entry <> disk_entry then
            mismatches := mismatches + 1;
            Print("  MISMATCH at disk-(", i_disk, ", ", j_disk,
                  "), comp-(", i_comp, ", ", j_comp, "):\n");
            Print("    g_1 = ", simples[i_comp].representative,
                  ", g_2 = ", simples[j_comp].representative, "\n");
            Print("    on-disk  S[", i_disk, "][", j_disk, "] = ",
                  disk_entry, "\n");
            Print("    computed S[", i_comp, "][", j_comp, "] = ",
                  computed_entry, "\n");
        else
            checked := checked + 1;
            Print("  match (i=", i_disk, " g_1=",
                  simples[i_comp].representative, ", j=", j_disk,
                  " g_2=", simples[j_comp].representative, ") = ",
                  disk_entry, "\n");
        fi;
    od;
    if mismatches > 0 then
        Error("Q_8 byte-for-byte test (up to σ): ", mismatches, "/",
              Length(central_pairs),
              " entries mismatched against modular_data/8/4/2.txt.");
    fi;
    Print("  PASS: Q_8 byte-for-byte test (", checked,
          " central-row entries match modular_data/8/4/2.txt under σ)\n");
end;;

############################################################
# Run all tests.
############################################################

Print("=== test_epsilon_omega.g ===\n");
Print("[1] Trivial-cocycle test...\n");
TestEpsilonOmegaTrivial();
Print("[2] Q_8 byte-for-byte (up to σ) test...\n");
TestEpsilonOmegaQ8();
Print("=== test_epsilon_omega.g: ALL PASS ===\n");
QUIT;
