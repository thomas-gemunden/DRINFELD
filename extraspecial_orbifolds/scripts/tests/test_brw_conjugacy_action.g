# Tests for BRW(m) outer-automorphism action on conjugacy classes of
# E_+(m). See scripts/brw_conjugacy_action.g for the implementation.
#
# Acceptance criteria verified here (per issue #29, task T-3b):
#   (A) Every generator's permutation preserves the BRW-orbit partition
#       of conjugacy classes.
#   (B) The subgroup of S_n generated by the per-generator permutations
#       has order |BRW(m)/E_+(m)| = |O^+(2m, F_2)|.
#         m = 2: order 72 inside S_17.
#         m = 3: order 40320 inside S_65.
#   (C) Each permutation actually lies in S_n with n = |Cclasses(E_+(m))|.

ChangeDirectoryCurrent("/Users/thomasgemunden/Projects/group_cohomology/DRINFELD-wt-t3b/extraspecial_orbifolds/scripts");
Read("brw_conjugacy_action.g");

# ---------------------------------------------------------------------
# Helpers.
# ---------------------------------------------------------------------

OplusOrder := function(m)
    return Order(GeneralOrthogonalGroup(1, 2*m, 2));
end;;

# Expected number of conjugacy classes of E_+(m): general formula
# 2^{2m} + 1 (central pair {1, -1} plus (|E_+(m)| - 2)/2 size-2 classes).
#   m = 1: 5 (matches D_8).
#   m = 2: 17 (per issue).
#   m = 3: 65 (per issue).
ExpectedClassCount := function(m)
    return 2^(2*m) + 1;
end;;

RunOneM := function(m)
    local action, n, expected_order, sub_order, ok_orbits, ok_count,
          summary, key, part, k, p, j, tic, toc;
    Print("\n========================================\n");
    Print("Tests for BRWConjugacyAction at m = ", m, "\n");
    Print("========================================\n");

    tic := Runtime();;
    action := BRWConjugacyAction(m);
    toc := Runtime() - tic;
    Print("BRWConjugacyAction(", m, ") built in ", toc/1000., " s\n");

    n := action.n_classes;
    Print("|Cclasses(E_+(", m, "))| = ", n, "\n");
    Print("  expected: ", ExpectedClassCount(m),
          "  match: ", n = ExpectedClassCount(m), "\n");

    # Report BRW-orbit partition.
    Print("\nBRW-orbit partition of conjugacy classes:\n");
    for key in SortedList(RecNames(action.orbit_partition)) do
        part := action.orbit_partition.(key);
        Print("  ", key, ":  ", Length(part), " classes (",
              part, ")\n");
    od;

    # Criterion (C): every permutation in S_n.
    Print("\n--- (C): each permutation moves only points in [1..", n, "] ---\n");
    ok_count := ForAll(action.perms, p ->
                       LargestMovedPoint(p) = 0 or LargestMovedPoint(p) <= n);
    Print("All perms ⊆ S_", n, ": ", ok_count, "\n");

    # Criterion (A): orbit-preservation.
    Print("\n--- (A): each generator preserves BRW-orbit partition ---\n");
    ok_orbits := VerifyOrbitPreservation(action);
    Print("Orbit-preserving: ", ok_orbits, "\n");
    if not ok_orbits then
        # Detail report.
        for key in RecNames(action.orbit_partition) do
            part := action.orbit_partition.(key);
            for k in [1..Length(action.perms)] do
                p := action.perms[k];
                for j in part do
                    if not (j^p in part) then
                        Print("  VIOLATION: gen ", k, " (type ", key,
                              ") sends ", j, " -> ", j^p, "\n");
                    fi;
                od;
            od;
        od;
    fi;

    # Criterion (B): subgroup order matches |BRW(m)/E_+(m)|.
    Print("\n--- (B): |<perms>| = |O^+(2m, F_2)| ---\n");
    expected_order := OplusOrder(m);
    tic := Runtime();;
    sub_order := Order(action.image_subgroup);
    toc := Runtime() - tic;
    Print("|<perms>| = ", sub_order,
          "  (computed in ", toc/1000., " s)\n");
    Print("|O^+(2m, F_2)| = ", expected_order, "\n");
    Print("Match: ", sub_order = expected_order, "\n");

    # Summary record.
    summary := rec(
        m := m,
        n_classes := n,
        all_in_Sn := ok_count,
        orbit_preserving := ok_orbits,
        subgroup_order := sub_order,
        expected_order := expected_order,
        passes := ok_count and ok_orbits and (sub_order = expected_order)
    );
    return summary;
end;;

# ---------------------------------------------------------------------
# Run m = 2.
# ---------------------------------------------------------------------

s2 := RunOneM(2);;

# ---------------------------------------------------------------------
# Run m = 3.  May be slower (65-class permutation group, generators
# need centraliser-heavy work).
# ---------------------------------------------------------------------

Print("\n========================================\n");
Print("About to run m = 3.  This is the heavier case.\n");
Print("========================================\n");

s3 := RunOneM(3);;

# ---------------------------------------------------------------------
# Overall summary.
# ---------------------------------------------------------------------

Print("\n========================================\n");
Print("Overall summary\n");
Print("========================================\n");
Print("m=2: ", s2, "\n");
Print("m=3: ", s3, "\n");
Print("\nAll passes: ", s2.passes and s3.passes, "\n");
