# Tests for BRWH3Action: BRW(m) action on H^3(E_+(m); U(1)) generators.
#
# Acceptance criteria verified here (per issue #30, task T-3c):
#   (A) Each matrix M_y is a well-defined endomorphism of prod Z/d_i.
#   (B) E_+(m) generators of BRW(m) act trivially on H^3 (inner auts).
#   (C) The subgroup of End(prod Z/d_i) generated by all matrices has
#       order = expected image size of BRW(m)/E_+(m) -> Aut(H^3).
#       For m = 2: full BRW(m)/E_+(m) = O^+(4, F_2) has order 72;
#       the image in Aut(H^3) may be smaller if some outer auts act
#       trivially.  Report what we see and use it as ground truth.
#   (D) For m = 2: spot-check matrices against expected behavior on
#       the 10 H^3 generators with torsion [2,...,2,8].
#
# Output: log to /tmp/brw_h3_action_test.log; final summary printed.

ChangeDirectoryCurrent(
    "/Users/thomasgemunden/Projects/group_cohomology/DRINFELD-wt-t3c/extraspecial_orbifolds/scripts");
Read("brw_h3_action.g");

LogPath := "/tmp/brw_h3_action_test.log";;
PrintTo(LogPath, "");

# ---------------------------------------------------------------------
# Helper: format and log a list/matrix.
# ---------------------------------------------------------------------

LogMatrix := function(M, prefix)
    local row;
    for row in M do
        AppendTo(LogPath, prefix, row, "\n");
    od;
end;;

# ---------------------------------------------------------------------
# Helper: identify BRW generators by index range (in the order
# GeneratorsOfGroup(BRW(m)) returns them).
#
# BRW(m) gens layout (see brw_construction.g BRW):
#   indices 1..2m+1:    E_+(m) generators (z = -I, sigma_{a,r})
#   indices 2m+2..3m+1: Hadamard in each slot a
#   indices 3m+2..end:  CZ on each (a, b) pair, a < b
# ---------------------------------------------------------------------

EmGenIndices := function(m) return [1..2*m+1]; end;;
HadamardGenIndices := function(m) return [2*m+2..3*m+1]; end;;
CZGenIndices := function(m)
    local n_total;
    n_total := 2*m+1 + m + Binomial(m, 2);
    return [3*m+2..n_total];
end;;

# ---------------------------------------------------------------------
# Main test driver.
# ---------------------------------------------------------------------

RunBRWH3Action := function(m)
    local action, k, torsion, n_gens, em_idx, had_idx, cz_idx, all_pass,
          i, M, tic, toc, em_act_trivial,
          gens_for_closure, closure, image_order, expected_oplus,
          summary, valid_count;

    AppendTo(LogPath, "\n========================================\n");
    AppendTo(LogPath, "BRWH3Action tests for m = ", m, "\n");
    AppendTo(LogPath, "========================================\n");

    tic := Runtime();;
    action := BRWH3Action(m);
    toc := Runtime() - tic;
    AppendTo(LogPath, "BRWH3Action(", m, ") built in ", toc/1000., " s\n");

    k := action.num_generators;
    torsion := action.torsion;
    n_gens := Length(action.brw_gens);
    em_idx := EmGenIndices(m);
    had_idx := HadamardGenIndices(m);
    cz_idx := CZGenIndices(m);

    AppendTo(LogPath, "H^3 torsion = ", torsion, "\n");
    AppendTo(LogPath, "k = ", k, "\n");
    AppendTo(LogPath, "BRW generators: ", n_gens, " (em: ", Length(em_idx),
            ", H: ", Length(had_idx), ", CZ: ", Length(cz_idx), ")\n");

    # ---- (A): each matrix is a valid endomorphism ----
    AppendTo(LogPath, "\n--- (A): each M_y well-defined on prod Z/d_i ---\n");
    valid_count := Length(Filtered(action.valid_endos, b -> b));
    AppendTo(LogPath, "Valid endomorphisms: ", valid_count, " / ", n_gens, "\n");
    for i in [1..n_gens] do
        if not action.valid_endos[i] then
            AppendTo(LogPath, "  VIOLATION at gen ", i, ":\n");
            LogMatrix(action.matrices[i], "    ");
        fi;
    od;
    all_pass := (valid_count = n_gens);

    # ---- (B): E_+(m) gens act trivially (inner auts) ----
    AppendTo(LogPath, "\n--- (B): E_+(m) generators act trivially on H^3 ---\n");
    em_act_trivial := true;
    for i in em_idx do
        M := action.matrices[i];
        if M <> IdH3Endomorphism(torsion) then
            AppendTo(LogPath, "  VIOLATION: gen ", i, " (inner) not identity:\n");
            LogMatrix(M, "    ");
            em_act_trivial := false;
        fi;
    od;
    AppendTo(LogPath, "All E_+(m) generators act trivially: ", em_act_trivial, "\n");
    all_pass := all_pass and em_act_trivial;

    # ---- (D): log Hadamard / CZ matrices for inspection ----
    AppendTo(LogPath, "\n--- (D): matrices for non-inner generators ---\n");
    for i in had_idx do
        AppendTo(LogPath, "\nGenerator ", i, " (Hadamard slot ",
                i - 2*m - 1, "):\n");
        LogMatrix(action.matrices[i], "  ");
    od;
    for i in cz_idx do
        AppendTo(LogPath, "\nGenerator ", i, " (CZ pair):\n");
        LogMatrix(action.matrices[i], "  ");
    od;

    # ---- (C): generated subgroup order ----
    AppendTo(LogPath, "\n--- (C): order of generated subgroup ---\n");
    # Only need non-trivial generators (E_+(m) ones are identity).
    gens_for_closure := Concatenation(
        List(had_idx, i -> action.matrices[i]),
        List(cz_idx, i -> action.matrices[i]));
    tic := Runtime();;
    closure := GeneratedH3SubgroupFast(gens_for_closure, torsion);
    toc := Runtime() - tic;
    image_order := Length(closure);
    AppendTo(LogPath, "|<M_H, M_CZ>| in End(prod Z/d_i) = ", image_order,
            "  (computed in ", toc/1000., " s)\n");
    expected_oplus := Order(GeneralOrthogonalGroup(1, 2*m, 2));
    AppendTo(LogPath, "|O^+(2m, F_2)| = |BRW(m)/E_+(m)| = ", expected_oplus, "\n");
    AppendTo(LogPath, "Image is ",
            If_(image_order = expected_oplus, "FULL",
                If_(expected_oplus mod image_order = 0,
                    Concatenation("a quotient of order ",
                                  String(image_order),
                                  " (kernel size ",
                                  String(expected_oplus / image_order),
                                  ")"),
                    "INCONSISTENT (not a divisor of |O^+|)")), "\n");

    summary := rec(
        m := m,
        k := k,
        torsion := torsion,
        n_gens := n_gens,
        valid_count := valid_count,
        em_act_trivial := em_act_trivial,
        image_order := image_order,
        expected_oplus_order := expected_oplus,
        full_image := image_order = expected_oplus,
        all_pass := all_pass and (image_order > 0) and
                    (expected_oplus mod image_order = 0)
    );
    AppendTo(LogPath, "\nSummary: ", summary, "\n");
    return summary;
end;;

# ---------------------------------------------------------------------
# Run m = 2 (10 H^3 generators, torsion [2,...,2,8], BRW/E_+ = 72).
# ---------------------------------------------------------------------

s2 := RunBRWH3Action(2);;

# ---------------------------------------------------------------------
# Final summary to terminal.
# ---------------------------------------------------------------------

Print("\n========================================\n");
Print("BRWH3Action test summary\n");
Print("========================================\n");
Print("m=2: ", s2, "\n");
Print("\nFull log at ", LogPath, "\n");
Print("\nAll passes: ", s2.all_pass, "\n");
