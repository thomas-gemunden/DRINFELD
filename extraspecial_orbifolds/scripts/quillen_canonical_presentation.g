# quillen_canonical_presentation.g — Q-2a Pass 1: canonical Quillen
# presentation of H^*(E_+(m); F_2) for m in {1, 2, 3}.
#
# Source: D. Quillen, "The mod 2 cohomology rings of extra-special
# 2-groups and the spinor groups", Math. Ann. 194 (1971), 197-212,
# Theorem 4.6 + Cor 2.6. The Adem-Milgram book [AM04, IV.2, Remarks
# 2.12-2.13, p.129-131] discusses extraspecial 2-groups as central
# products and points at Quillen [Q4] for the full presentation; the
# issue body's citation "[AM04, Theorem IV.7.7]" is a slip — Chapter
# IV §7 is "Steenrod Squares", which doesn't contain it. The actual
# canonical reference is the 1971 Quillen paper.
#
# Theorem 4.6 (Quillen 1971). Let 1 -> Z/2 -> ~V -> V -> 1 be a central
# extension classified by a quadratic function Q in S^2(V*), with B the
# associated bilinear form, and let h be the codimension in V of a
# maximal Q-isotropic subspace. Then
#
#     H^*(B~V; F_2) ≅ S(V*) / J  ⊗  F_2[w_{2^h}]
#
# where J is the ideal generated by the regular sequence
#
#     Q(x), B(x, x²), B(x, x^4), ..., B(x, x^{2^{h-1}})
#
# and w_{2^h} is any class in H^{2^h}(B~V) with i*(w_{2^h}) ≠ 0
# (Lemma 4.5). Cor 2.6 of the same paper shows the sequence is regular
# in S(V*).
#
# Specialisation to E_+(m). E_+(m) is the "+"-type / "real case" of
# Quillen §2: V = E_+(m)/[G,G] ≅ (F_2)^{2m}, h = m, and in the
# symplectic basis the quadratic form is (eq. 2.13)
#
#     Q(x) = sum_{i=1..m}  x_i · x_{m+i}.
#
# Bilinearisation B(x, y) = Q(x+y) + Q(x) + Q(y) gives
#
#     B(x, y) = sum_{i=1..m}  ( x_i · y_{m+i} + y_i · x_{m+i} )
#
# and substituting y = x^{2^k} (the F_2-Frobenius iterated k times):
#
#     B(x, x^{2^k}) = sum_{i=1..m}  ( x_i · x_{m+i}^{2^k}
#                                    + x_i^{2^k} · x_{m+i} )      (deg 1 + 2^k).
#
# By Remark 4.8 these relations are Steenrod-stable: B(x, x²) = Sq¹ Q,
# B(x, x^4) = Sq² Sq¹ Q, etc.
#
# Presentation summary, m in {1, 2, 3}:
#
#   m | rank V | generators              | relations               | deg(w)
#   --|--------|-------------------------|-------------------------|-------
#   1 |     2  | x_1, x_2; w             | Q                       |   2
#   2 |     4  | x_1..x_4; w             | Q, B(x,x²)              |   4
#   3 |     6  | x_1..x_6; w             | Q, B(x,x²), B(x,x^4)    |   8
#
# Cross-validation. For m=1, Theorem 4.6 reproduces AM04 Theorem IV.2.7
# verbatim (with x ↔ x_1, y ↔ x_2). For m=2, 3 the dimensions of H^d
# at deg 0..4 match the published HAP/Jena values:
#
#   m | d=0 | d=1 | d=2 | d=3 | d=4
#   --|-----|-----|-----|-----|----
#   1 |  1  |  2  |  3  |  4  |  5
#   2 |  1  |  4  |  9  | 15  | 22
#   3 |  1  |  6  | 20  | 49  | 99
#
# (These are computed in `tests/test_quillen_canonical_presentation.g`
# and asserted against the Q-1 BasisInDegree machinery. Crucially, the
# regular-sequence property guarantees the relations form a Gröbner
# basis under graded-lex, so BasisInDegree is correct as-is — no
# Buchberger reduction is needed, unlike the Jena Path 2 file which
# loses a syzygy at m=2.)
#
# Generator naming.
#   * x_i (1 <= i <= 2m) = pullback to H^1(B~V; F_2) of the i-th basis
#     element of V*, in the symplectic basis where Q is in normal form
#     (eq. 2.13).
#   * w = the inflation of z^{2^m} from H^{2^m}(BZ/2; F_2), where z is
#     the generator of H^1(BZ/2; F_2); equivalently, the unique class
#     restricting non-trivially via i*: H^*(B~V) -> H^*(BZ/2) (Lemma 4.5).

if not IsBoundGlobal("PolynomialTimesExterior") then
    _qcp_self := INPUT_FILENAME();;
    if _qcp_self <> fail and _qcp_self <> "stream" then
        _qcp_dir := _qcp_self{[1..Length(_qcp_self) -
                          Length("/quillen_canonical_presentation.g")]};;
        _qcp_cand := Concatenation(_qcp_dir, "/quillen_algebra.g");;
        if IsExistingFile(_qcp_cand) then Read(_qcp_cand); fi;
    fi;
    if not IsBoundGlobal("PolynomialTimesExterior")
       and IsExistingFile("quillen_algebra.g") then
        Read("quillen_algebra.g");
    fi;
fi;

# ---- Helpers ---------------------------------------------------------

# A sym-only monomial with given exponent tuple. The exterior part is
# empty (Quillen's algebra is purely polynomial; the exterior factor in
# Q-1's framework is unused here).
QCPMonomial := function(n_sym, exps)
    Assert(0, Length(exps) = n_sym,
           Concatenation("QCPMonomial: expected ", String(n_sym),
                         " entries, got ", String(Length(exps))));
    return rec(sym := ShallowCopy(exps), ext := []);
end;;

# Generator indexing within sym_gens. Layout for given m:
#   index 1..2m  -> x_1..x_{2m}
#   index 2m+1   -> w (degree 2^m)
QCPNumSym := function(m) return 2 * m + 1; end;;

# ---- Quillen's quadratic form Q(x) = sum_{i=1..m} x_i · x_{m+i} ------

QCPQuadraticQ := function(m)
    local n_sym, rel, i, exps;
    n_sym := QCPNumSym(m);
    rel := [];
    for i in [1..m] do
        exps := ListWithIdenticalEntries(n_sym, 0);
        exps[i] := 1;             # x_i
        exps[m + i] := 1;         # x_{m+i}; indices i and m+i are distinct
        Add(rel, QCPMonomial(n_sym, exps));
    od;
    return rel;
end;;

# ---- B(x, x^{2^k}) = sum_{i=1..m} ( x_i · x_{m+i}^{2^k}
#                                   + x_i^{2^k} · x_{m+i} ) -----------

QCPBilinearB := function(m, k)
    local n_sym, p, rel, i, exps;
    Assert(0, k >= 1, "B(x, x^{2^k}) is defined for k >= 1");
    n_sym := QCPNumSym(m);
    p := 2 ^ k;
    rel := [];
    for i in [1..m] do
        # x_i · x_{m+i}^p
        exps := ListWithIdenticalEntries(n_sym, 0);
        exps[i] := 1;
        exps[m + i] := p;
        Add(rel, QCPMonomial(n_sym, exps));
        # x_i^p · x_{m+i}
        exps := ListWithIdenticalEntries(n_sym, 0);
        exps[i] := p;
        exps[m + i] := 1;
        Add(rel, QCPMonomial(n_sym, exps));
    od;
    return rel;
end;;

# ---- Build the canonical presentation for general m >= 1 -------------

QuillenCanonicalPresentation := function(m)
    local sym_gens, relations, i, k;
    Assert(0, m >= 1, "m must be a positive integer");

    sym_gens := [];
    for i in [1..2 * m] do
        Add(sym_gens, rec(name := Concatenation("x_", String(i)), deg := 1));
    od;
    Add(sym_gens, rec(name := "w", deg := 2 ^ m));

    # Relations: Q (always), then B(x, x²), B(x, x^4), ..., B(x, x^{2^{m-1}}).
    relations := [QCPQuadraticQ(m)];
    for k in [1..m - 1] do
        Add(relations, QCPBilinearB(m, k));
    od;

    return PolynomialTimesExterior(sym_gens, [], relations);
end;;

# ---- Convenience entry points to match the Jena/HAP-Path naming ------

CanonicalPresentation := function(m)
    return QuillenCanonicalPresentation(m);
end;;

Print("Loaded quillen_canonical_presentation.g ",
      "(QuillenCanonicalPresentation 1..m).\n");
