# BRW(m) outer-automorphism action on E_+(m)-conjugacy classes.
#
# The Bolt-Room-Wall group BRW(m) normalises the extraspecial 2-group
# E_+(m) inside O(2^m). The quotient BRW(m)/E_+(m) ≅ O^+(2m, F_2) acts
# by conjugation on E_+(m), hence on the set of E_+(m)-conjugacy classes.
#
# This file builds, for each generator y of BRW(m), the induced
# permutation of ConjugacyClasses(E_+(m)). The E_+(m) generators of
# BRW(m) act by inner automorphisms and so contribute the identity
# permutation; non-trivial action comes from the Hadamard and CZ
# generators added in brw_construction.g.
#
# Reference: brw_construction.g for BRW(m) and EmGroup(m).
#
# Acceptance criteria (per issue #29):
#   - Every generator's permutation maps each BRW-orbit of classes to
#     itself (orbit-preservation).
#   - The subgroup of Sym(n_classes) generated by the permutations has
#     order |BRW(m)/E_+(m)| = |O^+(2m, F_2)|.
#   - m=2: 17 classes, expected subgroup order 72.
#   - m=3: 65 classes, expected subgroup order 40320.

if not IsBound(BRW) then
    Read("brw_construction.g");
fi;

# ---------------------------------------------------------------------
# Classification of E_+(m) conjugacy classes into BRW-orbit types.
#
# For E_+(m) of plus type, the BRW-action partitions classes by:
#   "id"             : identity (singleton orbit)
#   "minus_one"      : the central involution -I (singleton orbit)
#   "sigma2"         : non-central order-2 elements
#   "sigma_1sigma_2" : order-4 elements (only exists for m >= 2)
# ---------------------------------------------------------------------

ClassifyEmConjugacyClasses := function(G, classes)
    local types, i, cl, rep, ord, sz;
    types := [];
    for i in [1..Length(classes)] do
        cl := classes[i];
        rep := Representative(cl);
        ord := Order(rep);
        sz := Size(cl);
        if sz = 1 and ord = 1 then
            Add(types, "id");
        elif sz = 1 and ord = 2 then
            Add(types, "minus_one");
        elif ord = 2 then
            Add(types, "sigma2");
        elif ord = 4 then
            Add(types, "sigma_1sigma_2");
        else
            Add(types, "UNKNOWN");
        fi;
    od;
    return types;
end;;

# Build the orbit partition as a list of lists of class-indices.
OrbitPartitionFromTypes := function(types)
    local groups, t, i, parts, key;
    groups := rec();
    for i in [1..Length(types)] do
        t := types[i];
        if not IsBound(groups.(t)) then groups.(t) := []; fi;
        Add(groups.(t), i);
    od;
    parts := rec();
    for key in RecNames(groups) do
        parts.(key) := groups.(key);
    od;
    return parts;
end;;

# ---------------------------------------------------------------------
# Map an element x ∈ E_+(m) to the index of its conjugacy class.
#
# For E_+(m), the non-central conjugacy classes are size 2 ({g, -g})
# and the central ones are size 1 ({1} and {-1}). We materialise the
# full class element sets and use set membership for fast lookup,
# gated on element order. `class_elements[j]` is a sorted list of
# matrices in class j; `class_orders[j]` is Order(Representative(cl_j)).
#
# Legacy O(n_classes) linear scan; kept for backwards compatibility
# with helpers that have not been migrated to the dictionary path.
# The hot inner loop in BRWConjugacyAction uses a NewDictionary keyed
# by every element of the group, which is O(1) per lookup.
# ---------------------------------------------------------------------

ClassIndexOf := function(x, class_elements, class_orders)
    local ord, j;
    ord := Order(x);
    for j in [1..Length(class_elements)] do
        if class_orders[j] = ord and x in class_elements[j] then
            return j;
        fi;
    od;
    Error("element does not lie in any conjugacy class of the group");
end;;

# ---------------------------------------------------------------------
# A-7-perf-2 (#271): build a dictionary mapping every element g ∈ G to
# the index j of the conjugacy class containing g. For E_+(m), |G| =
# 2^{2m+1}, so the dictionary has 2^{2m+1} entries (32768 at m=7),
# replacing the O(n_classes^2) linear-scan setup in BRWConjugacyAction
# with O(|G|) build + O(1) lookup.
# ---------------------------------------------------------------------

BuildElementToClassIndexDict := function(G, classes)
    local d, j, cl, g;
    d := NewDictionary(One(G), true, G);
    for j in [1..Length(classes)] do
        cl := AsList(classes[j]);
        for g in cl do
            AddDictionary(d, g, j);
        od;
    od;
    return d;
end;;

# ---------------------------------------------------------------------
# Single-generator helper: given the BRW generator matrix y and the
# precomputed class info, return the induced permutation as a list
# image_list where image_list[i] = j means y maps class i to class j.
# ---------------------------------------------------------------------

BRWConjugacyActionFor := function(y, reps, class_elements, class_orders)
    local n, image_list, i, r, conj, j;
    n := Length(reps);
    image_list := [];
    for i in [1..n] do
        r := reps[i];
        # Conjugation y · r · y^{-1} (matrix-level).
        conj := y * r * y^(-1);
        j := ClassIndexOf(conj, class_elements, class_orders);
        Add(image_list, j);
    od;
    return PermList(image_list);
end;;

# ---------------------------------------------------------------------
# Main entry point: build the action of every generator of BRW(m) on
# the conjugacy classes of E_+(m).
#
# Returns a record with fields:
#   .m              : the input m
#   .em             : E_+(m) group
#   .brw            : BRW(m) group
#   .classes        : ConjugacyClasses(E_+(m))
#   .types          : per-class BRW-type label
#   .orbit_partition: record type -> list of class-indices
#   .perms          : list of permutations in Sym(n_classes), one per
#                     generator of BRW(m)
#   .image_lists    : list of image lists (parallel to .perms), in
#                     case the consumer wants the raw lists
#   .image_subgroup : Group(perms) ⊆ Sym(n_classes)
# ---------------------------------------------------------------------

# P-5 (#114): module-level cache, mirroring BRWH3Action. Independent
# of the H^3 generator index; rebuilt 35x by the driver in the
# original implementation.
_brw_conjugacy_action_cache := rec();;

BRWConjugacyAction := function(m)
    local key, em_mat, iso_em, em, brw, classes, reps, class_sizes,
          class_orders, class_elements, types, orbit_partition, gens,
          perms, image_lists, y, p, image_list, image_subgroup, n, i, k,
          result, class_idx_dict, conj, t_dict_start, t_dict_end,
          t_loop_start, t_loop_end, gens_em, gens_em_lifted,
          images_under_y, phi_y, t_hom_start, t_hom_end, t_hom_total_ms;
    Assert(0, m >= 1, "m must be a positive integer");

    key := Concatenation("m", String(m));
    if IsBound(_brw_conjugacy_action_cache.(key)) then
        return _brw_conjugacy_action_cache.(key);
    fi;

    # P-11 (#130): em is the pc-group form of EmGroup(m). HAP's
    # downstream work (resolutions, centralisers) is ~3000x faster on
    # pc-groups than on matrix groups. BRW(m) stays a matrix group; its
    # conjugation action on em (pc) is translated through iso_em.
    em_mat := EmGroup(m);
    iso_em := IsomorphismPcGroup(em_mat);
    em := Image(iso_em);
    brw := BRW(m);

    classes := ConjugacyClasses(em);
    reps := List(classes, Representative);
    class_sizes := List(classes, Size);
    class_orders := List(reps, Order);
    # Materialise each class as a sorted list for fast `in` checks.
    class_elements := List(classes, AsSSortedList);
    n := Length(classes);

    types := ClassifyEmConjugacyClasses(em, classes);
    orbit_partition := OrbitPartitionFromTypes(types);

    # A-7-perf-2 (#271): one-shot element -> class-index dictionary.
    # At m=7, |em| = 2^15 = 32768 elements across 16385 classes; this
    # converts the inner loop's class-index lookup from O(n_classes)
    # (linear scan through class_elements) to O(1) (dict probe).
    t_dict_start := Runtime();;
    class_idx_dict := BuildElementToClassIndexDict(em, classes);
    t_dict_end := Runtime();;

    # A-7-perf-2a (#271 follow-up): cache the BRW conjugation action on
    # em as a pc-group homomorphism per BRW generator.
    #
    # Each BRW generator y acts on em by g -> y*g*y^(-1). Mathematically
    # BRW is defined to normalise em (extraspecial subgroup), so this
    # action is an automorphism of em. Concretely: build the matrix-side
    # conjugates of em's generators ONCE per y (|GeneratorsOfGroup(em)|
    # matmuls + iso_em evals), then assemble a pc-group hom phi_y. The
    # inner loop over class reps then collapses from a 128x128 cyclotomic
    # matmul + iso_em eval (~150 ms each at m=7, ~16385 calls per BRW
    # gen, ~2 h total) to a pc-group hom evaluation (~100 us each,
    # ~100 s total). See acceptance test in
    # tests/test_brw_conjugacy_action.g and issue #271 comment 4472495339.
    gens_em := GeneratorsOfGroup(em);
    gens_em_lifted := List(gens_em,
                           g -> PreImagesRepresentative(iso_em, g));

    gens := GeneratorsOfGroup(brw);
    perms := [];
    image_lists := [];
    t_hom_total_ms := 0;
    t_loop_start := Runtime();;
    for i in [1..Length(gens)] do
        y := gens[i];
        # Build phi_y once per BRW generator. The matrix-arithmetic cost
        # (|gens_em| matmuls + iso_em evals + GroupHomomorphismByImagesNC
        # setup) lives here, not inside the per-class loop. NB: BRW
        # conjugation is known to be an automorphism of em (see header
        # comment); GroupHomomorphismByImagesNC skips the well-definedness
        # check that ByImages (no NC) would run.
        t_hom_start := Runtime();;
        images_under_y := List(gens_em_lifted,
                               g_lift -> Image(iso_em,
                                               y * g_lift * y^(-1)));
        phi_y := GroupHomomorphismByImagesNC(em, em,
                                             gens_em, images_under_y);
        t_hom_end := Runtime();;
        t_hom_total_ms := t_hom_total_ms + (t_hom_end - t_hom_start);

        # Per-class step: pc-group hom evaluation (fast), then O(1)
        # dictionary lookup. No matrix arithmetic, no iso_em call.
        image_list := EmptyPlist(n);
        for k in [1..n] do
            conj := Image(phi_y, reps[k]);
            image_list[k] := LookupDictionary(class_idx_dict, conj);
        od;
        Add(image_lists, image_list);
        p := PermList(image_list);
        Add(perms, p);
    od;
    t_loop_end := Runtime();;

    image_subgroup := Group(perms);

    result := rec(
        m := m,
        em := em,
        em_matrix := em_mat,
        iso_em := iso_em,
        brw := brw,
        classes := classes,
        reps := reps,
        class_sizes := class_sizes,
        class_orders := class_orders,
        class_elements := class_elements,
        types := types,
        orbit_partition := orbit_partition,
        n_classes := n,
        gens := gens,
        perms := perms,
        image_lists := image_lists,
        image_subgroup := image_subgroup,
        # A-7-perf-2 / A-7-perf-2a perf breakdown (s). brw_loop_s is the
        # total loop wall (hom-build + per-class hom eval + dict lookup);
        # hom_build_s is the sum of the matrix-side phi_y construction
        # walls, which is the only remaining matrix-arithmetic cost.
        timings := rec(
            element_dict_s := (t_dict_end - t_dict_start) / 1000.0,
            brw_loop_s     := (t_loop_end - t_loop_start) / 1000.0,
            hom_build_s    := t_hom_total_ms / 1000.0
        )
    );
    _brw_conjugacy_action_cache.(key) := result;
    return result;
end;;

# ---------------------------------------------------------------------
# Verification helper: check that each generator's permutation
# preserves the BRW-orbit partition (i.e. classes in orbit O map to
# classes in O).
# ---------------------------------------------------------------------

VerifyOrbitPreservation := function(action)
    local ok, key, part, perms, p, i, j;
    ok := true;
    perms := action.perms;
    for key in RecNames(action.orbit_partition) do
        part := action.orbit_partition.(key);
        for p in perms do
            for i in part do
                j := i^p;  # image of i under permutation p
                if not (j in part) then
                    ok := false;
                fi;
            od;
        od;
    od;
    return ok;
end;;
