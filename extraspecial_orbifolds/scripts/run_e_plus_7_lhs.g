# run_e_plus_7_lhs.g — m=7 LHS resolution + cohomology driver.
#
# Issue #238 (Q-int C-2). Runs LHSResolutionEPlus(7, 5) and persists
# the outcome (timing, memory, H^3, H^4) to
# ../../computed/transgression/7/lhs_resolution_outcome.g for
# consumption by downstream m=7 drivers (#50 A-7a, #166 B2-6, B3-5 m=7).
#
# Run from extraspecial_orbifolds/scripts/:
#   /opt/homebrew/bin/gap -o 16g -q -b -c \
#       'Read("run_e_plus_7_lhs.g"); QUIT;'
#
# Conventions match run_e_plus_5_resolution.g: GAP writes a structured
# return-rec file with success/wall-clock/heap fields. A wrapper shell
# script (if added later) can fill in peak_rss_mb via OS-level
# polling.

LoadPackage("hap");;
LoadPackage("io");;

if not IsBoundGlobal("LHSResolutionEPlus") then
    Read("hap_lhs_resolution.g");
fi;

If_ := function(cond, a, b) if cond then return a; else return b; fi; end;;

WallClockSec := function()
    return Float(NanosecondsSinceEpoch()) / 1.0e9;
end;;

# ISO-8601 UTC timestamp via IO; degrades to "epoch+<seconds>".
IsoTimestamp := function()
    local r;
    r := CALL_WITH_CATCH(CurrentDateTimeString, [["-u"]]);
    if r[1] then return r[2]; fi;
    return Concatenation("epoch+", String(Int(WallClockSec())));
end;;

GapHeapMB := function()
    local r, s;
    r := CALL_WITH_CATCH(GasmanStatistics, []);
    if not r[1] then return -1.0; fi;
    s := r[2];
    if IsBound(s.full) and IsBound(s.full.livekb) then
        return Float(s.full.livekb) / 1024.0;
    fi;
    return -1.0;
end;;

# Resolve outcome path. Same convention as the m=5 driver.
OUTCOME_PATH :=
    "../../computed/transgression/7/lhs_resolution_outcome.g";;

# Pretty-print a torsion vector as "(Z/2)^a (+) Z/4 (+) ..." for the
# outcome file.
FormatTorsion := function(H)
    local entries, counts, parts, e;
    if IsEmpty(H) then return "0"; fi;
    entries := Set(H);
    counts := List(entries, e -> Length(Filtered(H, x -> x = e)));
    parts := [];
    for e in [1..Length(entries)] do
        if counts[e] = 1 then
            Add(parts, Concatenation("Z/", String(entries[e])));
        else
            Add(parts, Concatenation("(Z/", String(entries[e]),
                                     ")^", String(counts[e])));
        fi;
    od;
    return JoinStringsWithSeparator(parts, " (+) ");
end;;

WriteOutcome := function(path, rec_)
    local stream;
    stream := OutputTextFile(path, false);
    Assert(0, stream <> fail,
           Concatenation("could not open ", path, " for writing"));
    SetPrintFormattingStatus(stream, false);
    PrintTo(stream,
        "# E_+(7) LHS-perturbed HAP resolution outcome (Q-int C-2, ",
        "issue #238).\n",
        "# Generated by run_e_plus_7_lhs.g. peak_rss_mb is filled in ",
        "by an\n",
        "# OS-level wrapper if present; otherwise \"unknown\".\n",
        "return rec(\n",
        "    group_label         := \"E_+(7)\",\n",
        "    group_order         := 32768,\n",
        "    resolution_arity    := ", String(rec_.max_n), ",\n",
        "    builder             := \"", rec_.builder, "\",\n",
        "    success             := ",
        If_(rec_.success, "true", "false"), ",\n",
        "    wall_clock_sec      := ", String(rec_.wall_clock_sec),
        ",\n",
        "    build_time_V_sec    := ", String(rec_.build_time_V_sec),
        ",\n",
        "    build_time_LHS_sec  := ",
        String(rec_.build_time_LHS_sec), ",\n",
        "    gap_heap_mb         := ", String(rec_.gap_heap_mb), ",\n",
        "    peak_rss_mb         := \"unknown\",\n",
        "    R_V_dims            := ", String(rec_.R_V_dims), ",\n",
        "    R_E_dims            := ", String(rec_.R_E_dims), ",\n",
        "    H3_value            := ", String(rec_.H3_value), ",\n",
        "    H3_pretty           := \"", rec_.H3_pretty, "\",\n",
        "    H4_value            := ", String(rec_.H4_value), ",\n",
        "    H4_pretty           := \"", rec_.H4_pretty, "\",\n",
        "    error_msg           := \"", rec_.error_msg, "\",\n",
        "    started_at          := \"", rec_.started_at, "\"\n",
        ");;\n");
    CloseStream(stream);
end;;

# --- Driver ---------------------------------------------------------

RunEPlus7LHS := function(max_n)
    local started_at, t0, captured, det, R_E, H3, H4,
          wall_total, heap, success, error_msg, H3_value, H4_value,
          H3_pretty, H4_pretty, build_V, build_LHS, R_V_dims, R_E_dims;

    started_at := IsoTimestamp();
    Print("[A-7a/C-2] starting LHSResolutionEPlus(7, ", max_n,
          ") at ", started_at, "\n");

    t0 := WallClockSec();
    captured := CALL_WITH_CATCH(LHSResolutionEPlusDetailed,
                                [7, max_n]);
    if not captured[1] then
        wall_total := WallClockSec() - t0;
        error_msg := ReplacedString(String(captured[2]), "\"", "\\\"");
        Print("[A-7a/C-2] BUILD FAILED in ", wall_total, " s: ",
              error_msg, "\n");
        WriteOutcome(OUTCOME_PATH, rec(
            max_n             := max_n,
            builder           := "abelian",
            success           := false,
            wall_clock_sec    := wall_total,
            build_time_V_sec  := -1.0,
            build_time_LHS_sec := -1.0,
            gap_heap_mb       := GapHeapMB(),
            R_V_dims          := [],
            R_E_dims          := [],
            H3_value          := [],
            H3_pretty         := "",
            H4_value          := [],
            H4_pretty         := "",
            error_msg         := error_msg,
            started_at        := started_at
        ));
        return rec(success := false, error_msg := error_msg);
    fi;
    det := captured[2];
    R_E := det.R_E;
    build_V := det.build_time_V;
    build_LHS := det.build_time_LHS;
    R_V_dims := List([0..max_n], d -> det.R_V!.dimension(d));
    R_E_dims := List([0..max_n], d -> R_E!.dimension(d));

    Print("[A-7a/C-2] R_E built. Computing H^3...\n");
    H3 := Cohomology(HomToIntegers(R_E), 3);
    H3_pretty := FormatTorsion(H3);
    Print("[A-7a/C-2]   H^3 = ", H3_pretty, "\n");

    Print("[A-7a/C-2] Computing H^4 (HK-target = (Z/2)^454 (+) Z/4)...\n");
    H4 := Cohomology(HomToIntegers(R_E), 4);
    H4_pretty := FormatTorsion(H4);
    Print("[A-7a/C-2]   H^4 = ", H4_pretty, "\n");

    wall_total := WallClockSec() - t0;
    heap := GapHeapMB();
    success := true;
    error_msg := "";

    Print("[A-7a/C-2] Total wall = ", wall_total, " s, heap = ",
          heap, " MB\n");

    WriteOutcome(OUTCOME_PATH, rec(
        max_n             := max_n,
        builder           := det.R_V_builder,
        success           := success,
        wall_clock_sec    := wall_total,
        build_time_V_sec  := build_V,
        build_time_LHS_sec := build_LHS,
        gap_heap_mb       := heap,
        R_V_dims          := R_V_dims,
        R_E_dims          := R_E_dims,
        H3_value          := H3,
        H3_pretty         := H3_pretty,
        H4_value          := H4,
        H4_pretty         := H4_pretty,
        error_msg         := error_msg,
        started_at        := started_at
    ));
    Print("[A-7a/C-2] wrote ", OUTCOME_PATH, "\n");

    return rec(success := true,
               wall_clock_sec := wall_total,
               gap_heap_mb    := heap,
               R_E_dims       := R_E_dims,
               H3             := H3,
               H4             := H4);
end;;

# Auto-invoke as a script unless the test suite asks us to defer.
if not IsBoundGlobal("EPLUS7_LHS_NO_AUTOINVOKE") then
    RunEPlus7LHS(5);
fi;
