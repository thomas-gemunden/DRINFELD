# k4b_xcheck_d_van.g — K-4b cross-validation against D-VAN at m = 5.
#
# Goal: confirm that K-4b's detecting-family verdict (from the KRR
# lattice via CGR §5.2) is consistent with what D-VAN derives from the
# algebraic restriction of a cohomology class on E_+(5).
#
# This harness is part of the K-4b deliverable bundle. The K-4b spec
# (docs/superpowers/specs/2026-05-17-k4b-m5-production-spec.md) lays
# out two cross-validation strategies, in order of preference:
#
#   (A) FULL CHECK — invert K-4b's per-subgroup classes back to an
#       H^3(E_+(5); U(1)) orbit via `_DVAN_InvertRestriction(m,
#       E_class, D8_class, Q8_class)`. The K-4b classes are restrictions
#       of some ω ∈ H^3(E_+(m); U(1)); D-VAN knows the restriction
#       matrices, so given (res_E, res_D8, res_Q8) it can solve for
#       candidate orbits of ω. The number of candidates is itself a
#       check: 0 -> inconsistent, 1 -> consistent + identifies the
#       orbit, >1 -> injectivity gap (cf. R-1, issue #193).
#
#   (B) FALLBACK CHECK — at the trivial-trivial axis only:
#         "K-4b verdict = trivial  IFF  D-VAN(ω = 0).trivial = true."
#       This is much weaker — it only confirms that the two pipelines
#       agree on the zero class — but it is cheap and unblocks K-4b
#       ship while strategy (A) waits for `_DVAN_InvertRestriction` to
#       be implemented.
#
# Current status (this scaffold ships AHEAD of the production run):
#
#   - `_DVAN_InvertRestriction(m, E_class, D8_class, Q8_class)` does
#     not yet exist as a callable helper. The implementation sketch
#     in the K-4b spec assumes D-VAN's `BuildRestrictionMatrices(m)`
#     exposes res_E_list, res_D8, res_Q8 (it does, since #154); the
#     inversion is a Smith-normal-form / lattice-coset enumeration
#     over Z mod torsion. See the helper stub below and the
#     accompanying TODO listing what's needed.
#
#   - The fallback (B) is implemented and runs whenever (A)'s helper
#     returns `fail` (the stub return value).
#
# Usage (after k4b_m5_result.g has been generated by run_k4b_m5.sh):
#
#   gap -q -b -c 'Read("k4b_xcheck_d_van.g");'
#
# The harness prints a single-line summary (`CONSISTENT`, `MULTIPLE`,
# `INCONSISTENT`, or — for the fallback path — `TRIVIAL-AXIS OK` /
# `TRIVIAL-AXIS DISAGREE`) and QUITs.

# ---- Locate self ------------------------------------------------------
# Issue #422: robust filename suffix check before extracting the dir.
# Previously assumed `INPUT_FILENAME()` always ends in
# `/k4b_xcheck_d_van.g`, which fails when the file is relocated or
# invoked with a different leading-path convention; the bad extraction
# produced `_K4B_RESULT_PATH = "/k4b_m5_result.g"` (with a leading /).
_K4B_XCHECK_SELF := INPUT_FILENAME();;
_K4B_SUFFIX := "k4b_xcheck_d_van.g";;
_K4B_XCHECK_DIR := fail;;
if _K4B_XCHECK_SELF <> fail and _K4B_XCHECK_SELF <> "stream"
   and Length(_K4B_XCHECK_SELF) >= Length(_K4B_SUFFIX)
   and _K4B_XCHECK_SELF{[Length(_K4B_XCHECK_SELF) - Length(_K4B_SUFFIX) + 1
                          .. Length(_K4B_XCHECK_SELF)]} = _K4B_SUFFIX then
    _K4B_XCHECK_DIR := _K4B_XCHECK_SELF{
        [1..Length(_K4B_XCHECK_SELF) - Length(_K4B_SUFFIX)]};;
    # Strip trailing slash (if any) so subsequent Concatenations are well-shaped.
    if Length(_K4B_XCHECK_DIR) > 0
       and _K4B_XCHECK_DIR[Length(_K4B_XCHECK_DIR)] = '/' then
        _K4B_XCHECK_DIR := _K4B_XCHECK_DIR{
            [1..Length(_K4B_XCHECK_DIR) - 1]};;
    fi;
fi;;

# ---- Step 1: load K-4b result -----------------------------------------
# k4b_m5_result.g is written by run_k4b_m5.sh and binds the global
# RESULT (= the K4aClassify(5) record). If it doesn't exist yet we
# emit a clear instruction rather than fail with a cryptic error.
#
# Lookup order:
#   1. <script-dir>/k4b_m5_result.g   (when INPUT_FILENAME resolved)
#   2. ./k4b_m5_result.g              (CWD fallback)
# The first existing match wins.
_K4B_RESULT_PATH := fail;;
if _K4B_XCHECK_DIR <> fail and _K4B_XCHECK_DIR <> ""
   and IsExistingFile(Concatenation(_K4B_XCHECK_DIR,
                                      "/k4b_m5_result.g")) then
    _K4B_RESULT_PATH := Concatenation(_K4B_XCHECK_DIR,
                                       "/k4b_m5_result.g");;
elif IsExistingFile("k4b_m5_result.g") then
    _K4B_RESULT_PATH := "k4b_m5_result.g";;
fi;;

if _K4B_RESULT_PATH = fail then
    Print("[k4b_xcheck] BLOCKED: k4b_m5_result.g not found.\n");
    Print("[k4b_xcheck]   Checked candidate paths:\n");
    if _K4B_XCHECK_DIR <> fail and _K4B_XCHECK_DIR <> "" then
        Print("[k4b_xcheck]     ", _K4B_XCHECK_DIR, "/k4b_m5_result.g\n");
    fi;
    Print("[k4b_xcheck]     ./k4b_m5_result.g (relative to CWD)\n");
    Print("[k4b_xcheck]   Run ./run_k4b_m5.sh first to generate it.\n");
    Print("[k4b_xcheck]   The result file is the persisted output of\n");
    Print("[k4b_xcheck]   K4aClassify(5) and is required input here.\n");
    QuitGap(0);
fi;

Read(_K4B_RESULT_PATH);   # binds RESULT

if not IsBound(RESULT) then
    Print("[k4b_xcheck] BLOCKED: ", _K4B_RESULT_PATH,
          " did not bind RESULT.\n");
    Print("[k4b_xcheck]   The file should contain `RESULT := rec(...);;`.\n");
    Print("[k4b_xcheck]   Has it been hand-edited / truncated?\n");
    QuitGap(0);
fi;

Print("[k4b_xcheck] Loaded K-4b verdict from ", _K4B_RESULT_PATH, "\n");
Print("[k4b_xcheck]   m              = ", RESULT.m, "\n");
Print("[k4b_xcheck]   verdict        = ", RESULT.verdict, "\n");
Print("[k4b_xcheck]   E_class.is_coboundary = ",
      RESULT.E_class.is_coboundary, "\n");
Print("[k4b_xcheck]   D8_class.class_idx    = ",
      RESULT.D8_class.class_idx, " (trivial = 1)\n");
Print("[k4b_xcheck]   Q8_class.class_idx    = ",
      RESULT.Q8_class.class_idx, " (trivial = 1)\n");

# ---- Step 2: load D-VAN siblings -------------------------------------
# detecting_family_vanish.g is the D-VAN-3 vanishing test (issue #144).
# Loading it transitively pulls in detecting_family_restriction.g,
# fsi_wrapper.g, transgression_kernel.g, etc. — everything we need
# to evaluate D-VAN(ω) for an arbitrary hom-basis coord vector ω.
if not IsBound(ResIsTrivialOnDetectingFamily) then
    if _K4B_XCHECK_DIR <> fail
       and IsExistingFile(Concatenation(_K4B_XCHECK_DIR,
                                         "/detecting_family_vanish.g")) then
        Read(Concatenation(_K4B_XCHECK_DIR, "/detecting_family_vanish.g"));
    else
        Read("detecting_family_vanish.g");
    fi;
fi;
if not IsBound(BuildRestrictionMatrices) then
    if _K4B_XCHECK_DIR <> fail
       and IsExistingFile(Concatenation(_K4B_XCHECK_DIR,
                                         "/detecting_family_restriction.g")) then
        Read(Concatenation(_K4B_XCHECK_DIR,
                            "/detecting_family_restriction.g"));
    else
        Read("detecting_family_restriction.g");
    fi;
fi;

Print("[k4b_xcheck] D-VAN siblings loaded.\n");

# ---- _DVAN_InvertRestriction stub ------------------------------------
# Strategy (A) helper. Takes the K-4b verdict's three per-subgroup
# class identifiers and returns the list of candidate H^3(E_+(m); U(1))
# orbits whose restrictions match.
#
# CURRENT STATUS: STUB.  Returns `fail` so the caller falls back to
# strategy (B) below.
#
# WHAT IT WOULD NEED TO DO (sketch — to be filed as a sub-issue when
# strategy (A) becomes the blocker):
#
# 1. Translate K-4b's class identifiers into D-VAN's hom-basis coords:
#
#    * E branch: K-4b returns `E_class.is_coboundary :: bool` plus
#      the modular_ct / modular_untwisted records. For (A) we need
#      the actual coordinate vector of ω|_E in H^3(E; U(1)) — D-VAN
#      computes that as `res_E_vec` for any ω input, but going the
#      OTHER direction (modular-data class -> cohomology vector) is
#      non-trivial. The simplest path is to enumerate H^3(E; U(1))
#      coord vectors v, compute their modular data via
#      `ComputeCTModularData`, and match against `RESULT.E_class.
#      modular_ct`. Cost: |H^3(E; U(1))| at m = 5 with E = (Z/2)^6;
#      torsion shape = [2, ..., 2] of length k_E = 20 (per A-3a
#      output); so 2^20 ≈ 10^6 enumerations — feasible.
#
#    * D_8 branch: K-4b returns `D8_class.class_idx in [1..22]`
#      (the modular_data/8/3 orbit index). Each orbit has a stored
#      3-cocycles.txt vector that gives the hom-basis coord vector
#      directly. So this is a table lookup once the convention from
#      `modular_data/8/3/3-cocycles.txt` is wired up.
#
#    * Q_8 branch: same as D_8 but for modular_data/8/4
#      (class_idx in [1..8], stored vectors live there).
#
# 2. Use the restriction matrices `rec_m.res_EA_list`, `rec_m.res_D8`,
#    `rec_m.res_Q8` from `BuildRestrictionMatrices(m, "hap")` to set
#    up a linear system over Z (modulo each subgroup's torsion vector):
#
#        Find ω ∈ Z^{k_G} such that
#          ω . res_E    ≡ v_E    (mod torsion_E)    [from step 1]
#          ω . res_D8   ≡ v_D8   (mod torsion_D8)
#          ω . res_Q8   ≡ v_Q8   (mod torsion_Q8).
#
#    This is a standard CRT / Smith-normal-form solve. HAP's
#    `SolutionsMatDestructive` over an integer matrix with explicit
#    torsion would work; ad hoc loop over the (small) torsion of G
#    is also fine — `torsion_G` for E_+(5) is e.g. [2,2,2,2,2,2,4,4]
#    (verify via UCT), so the enumerator is at most ~2^8 * 4 = ~1k.
#
# 3. Quotient by Aut(E_+(5)) orbits if the K-4b classes were
#    Aut-orbit-invariant (which they are — the modular_data storage
#    convention is Aut(G)-orbit reps).
#
# 4. Return the list of candidate ω orbits.
#
# Until that is implemented, returning `fail` triggers the
# fallback-only check.
_DVAN_InvertRestriction := function(m, E_class, D8_class, Q8_class)
    # TODO(K-4b strategy A): see the docstring above for the full sketch.
    # When the production run lands and the verdict is something other
    # than fully-trivial, this stub will need to be replaced with the
    # actual inversion routine (or the work scoped into a follow-up
    # issue). For the m = 5 anchor case (verdict = "trivial"), the
    # fallback below provides a meaningful cross-check.
    return fail;
end;;

# ---- Step 3: try strategy (A) ----------------------------------------
Print("\n[k4b_xcheck] Attempting strategy (A): full restriction-inversion.\n");
candidate_omega_orbits := _DVAN_InvertRestriction(
    RESULT.m, RESULT.E_class, RESULT.D8_class, RESULT.Q8_class);;

if candidate_omega_orbits = fail then
    Print("[k4b_xcheck]   strategy (A) helper returned `fail` (stub).\n");
    Print("[k4b_xcheck]   See `_DVAN_InvertRestriction` docstring for the\n");
    Print("[k4b_xcheck]   work needed to implement it. Falling back to\n");
    Print("[k4b_xcheck]   strategy (B): trivial-axis check.\n");
elif IsList(candidate_omega_orbits) then
    # Issue #422: `QUIT;` is illegal inside nested if/elif/else blocks in
    # modern GAP. Use the `QuitGap(0)` function form, which is legal at
    # any nesting depth.
    if Length(candidate_omega_orbits) = 0 then
        Print("[k4b_xcheck] INCONSISTENT: no ω has the K-4b restrictions.\n");
        Print("[k4b_xcheck]   Diagnostic: check K-4a-T5b's σ phase, or\n");
        Print("[k4b_xcheck]   T4b's ε extraction. See K-4b spec §Risks.\n");
        QuitGap(0);
    elif Length(candidate_omega_orbits) > 1 then
        Print("[k4b_xcheck] MULTIPLE: ", Length(candidate_omega_orbits),
              " ω orbits match.\n");
        Print("[k4b_xcheck]   Indicates injectivity gap in {E, D_8, Q_8}\n");
        Print("[k4b_xcheck]   — see R-1, issue #193.\n");
        QuitGap(0);
    else
        Print("[k4b_xcheck] CONSISTENT: unique ω orbit matches.\n");
        Print("[k4b_xcheck]   Orbit ", candidate_omega_orbits[1],
              " of H³(E_+(", RESULT.m, "); U(1)).\n");
        QuitGap(0);
    fi;
fi;

# ---- Step 4: strategy (B) fallback -----------------------------------
# "K-4b verdict = trivial  IFF  D-VAN(ω = 0).trivial = true."
#
# We compute D-VAN(ω = 0) by passing the zero hom-basis coord vector to
# `ResIsTrivialOnDetectingFamily`. Since hom-basis projection of the
# zero cocycle is the zero vector, the function should always return
# trivial = true here — this isn't a test of D-VAN, it's establishing
# the LHS of the iff in known form.
#
# The actual cross-check is the comparison of the two booleans:
#
#   K-4b trivial?     RESULT.trivial = true (verdict = "trivial")
#                     RESULT.trivial = false (verdict = "non-trivial")
#                     RESULT.trivial = fail  (verdict = "incomplete")
#   D-VAN(ω = 0).trivial?    always true   (it's the zero class)
#
# So the check is really:
#   K-4b verdict = "trivial"  <=>  K-4b agrees with D-VAN that
#                                  ω = 0 has trivial restrictions.
#
# For the K-4b non-trivial verdict, the fallback can't say anything
# useful: K-4b found a non-trivial restriction, D-VAN(0) found a
# trivial one — they disagree by construction. That's why strategy
# (A) is the real answer for non-trivial verdicts. The fallback's
# value is in the trivial case: it confirms the two pipelines align
# at the zero point.

Print("\n[k4b_xcheck] Strategy (B) fallback: trivial-axis consistency.\n");

# Compute the per-subgroup torsion-zero baseline. We need the
# rec_m return from BuildRestrictionMatrices to know the right
# hom-basis dimension k_G, then pass a zero vector of that length.
_K4B_REC := BuildRestrictionMatrices(RESULT.m, "hap");;
_K4B_KG  := _K4B_REC.setup_G.num_generators;;
_K4B_ZERO_OMEGA := ListWithIdenticalEntries(_K4B_KG, 0);;
_K4B_DVAN_AT_ZERO := ResIsTrivialOnDetectingFamily(RESULT.m, _K4B_ZERO_OMEGA);;

Print("[k4b_xcheck]   D-VAN(ω = 0).trivial = ",
      _K4B_DVAN_AT_ZERO.trivial, "\n");
Print("[k4b_xcheck]   K-4b RESULT.trivial  = ", RESULT.trivial, "\n");

# The iff for the trivial-axis check.
if RESULT.trivial = true and _K4B_DVAN_AT_ZERO.trivial = true then
    Print("[k4b_xcheck] TRIVIAL-AXIS OK\n");
    Print("[k4b_xcheck]   K-4b says α is detected-trivial, and D-VAN(ω=0)\n");
    Print("[k4b_xcheck]   confirms the zero class has all-trivial restrictions.\n");
    Print("[k4b_xcheck]   This is the consistent-trivial outcome.\n");
elif RESULT.trivial = false then
    Print("[k4b_xcheck] TRIVIAL-AXIS INCONCLUSIVE\n");
    Print("[k4b_xcheck]   K-4b says α is NON-trivial; the fallback check\n");
    Print("[k4b_xcheck]   only verifies trivial-axis alignment and cannot\n");
    Print("[k4b_xcheck]   confirm the non-trivial verdict against D-VAN.\n");
    Print("[k4b_xcheck]   ACTION: implement _DVAN_InvertRestriction (see\n");
    Print("[k4b_xcheck]   the docstring above) to enable strategy (A).\n");
elif RESULT.trivial = fail then
    Print("[k4b_xcheck] TRIVIAL-AXIS INCOMPLETE\n");
    Print("[k4b_xcheck]   K-4b returned verdict = \"incomplete\"; rerun\n");
    Print("[k4b_xcheck]   run_k4b_m5.sh and address whichever branch\n");
    Print("[k4b_xcheck]   failed before re-running this xcheck.\n");
else
    Print("[k4b_xcheck] TRIVIAL-AXIS DISAGREE\n");
    Print("[k4b_xcheck]   Unexpected: K-4b trivial but D-VAN(0) non-trivial,\n");
    Print("[k4b_xcheck]   or some other state combination. Investigate.\n");
fi;

QuitGap(0);
