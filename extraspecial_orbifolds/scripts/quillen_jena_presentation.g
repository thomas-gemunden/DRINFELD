# quillen_jena_presentation.g — Q-2a Pass 2.
#
# Transcribes the Jena cohomology-database presentations of
# H^*(E_+(m); F_2) for m in {1, 2, 3} into Q-1 `quillen_algebra` records.
#
# KNOWN LIMITATION (dim-mismatch at E_+(2) deg 3, 4):
#   The Jena relations are minimal but not Gröbner-reduced. Q-1's
#   BasisInDegree reduces each monomial against the given relations and
#   takes the F_2 span, which is correct iff the supplied relations
#   form a Gröbner basis. For E_+(2), rel1 + rel2 misses the syzygy
#       rel1 * b_1_3 + rel2  =  b_1_2 * b_1_3 * (b_1_0 + b_1_1) ,
#   so BasisInDegree returns 16 (resp. 26) at deg 3 (resp. 4) instead
#   of the correct 15 (resp. 22). Fix paths (filed as Q-2a follow-up):
#     (a) Compute Gröbner basis of the ideal generated by {rel1, rel2}
#         and use the Gröbner-reduced set in PolynomialTimesExterior.
#     (b) Extend BasisInDegree to do Buchberger S-polynomial reduction
#         on-the-fly when the supplied relations don't satisfy the
#         Gröbner property.
#   D_8 (m=1) has a single relation, so the issue doesn't arise; deg
#   0..4 dims pass cleanly.
# Source: https://users.fmi.uni-jena.de/cohomology/ (Carlson, Green et al.),
# specifically pages /8web/8gp3.html, /32web/32gp49.html, /128web/128gp2326.html.
# The presentations there are computer-generated by the Sage
# `p_group_cohomology` package.
#
# Generator naming follows the Jena convention exactly:
#   * m = 1 (D_8 = SmallGroup(8, 3)):
#       b_1_0 (deg 1), b_1_1 (deg 1), c_2_2 (deg 2, Duflot regular).
#       1 relation: b_1_0 · b_1_1.
#   * m = 2 (E_+(2) = SmallGroup(32, 49) = "E32+"):
#       b_1_0, b_1_1, b_1_2, b_1_3 (deg 1) and c_4_21 (deg 4, Duflot).
#       2 relations:
#         rel1 (deg 2): b_1_1·b_1_2 + b_1_0·b_1_3 + b_1_0·b_1_1.
#         rel2 (deg 3): b_1_0·b_1_3^2 + b_1_0·b_1_2·b_1_3 + b_1_0·b_1_1·b_1_3.
#   * m = 3 (E_+(3) = SmallGroup(128, 2326) = "E128+"):
#       b_1_0..b_1_5 (deg 1) and c_8_580 (deg 8, Duflot).
#       3 relations:
#         rel1 (deg 2): b_1_2·b_1_3 + b_1_1·b_1_4 + b_1_0·b_1_5 + b_1_0·b_1_1.
#         rel2 (deg 3): 12 terms (transcribed below).
#         rel3 (deg 5): 33 terms (NOT YET TRANSCRIBED — fetch verbatim
#                                   from the Jena page in a follow-up).
#
# Pass-1 (AM04 canonical) cross-validation is a separate file
# (quillen_am04_presentation.g, deferred — agent stalled while reading
# the AM04 PDF; Pass 1 will be a manual transcription against IV.7.7).

# ---- Load Q-1 framework lazily ---------------------------------------
_qjp_loaded := IsBoundGlobal("PolynomialTimesExterior");;
if not _qjp_loaded then
    _qjp_self := INPUT_FILENAME();;
    if _qjp_self <> fail and _qjp_self <> "stream" then
        _qjp_dir := _qjp_self{[1..Length(_qjp_self) -
                          Length("/quillen_jena_presentation.g")]};;
        _qjp_cand := Concatenation(_qjp_dir, "/quillen_algebra.g");;
        if IsExistingFile(_qjp_cand) then
            Read(_qjp_cand);
            _qjp_loaded := true;
        fi;
    fi;
    if not _qjp_loaded and IsExistingFile("quillen_algebra.g") then
        Read("quillen_algebra.g");
        _qjp_loaded := true;
    fi;
fi;

# ---- Helpers ---------------------------------------------------------

# Build a single monomial in F_2[gens] with the given exponent tuple.
# n_sym is the number of sym gens; mon_exps is a list of n_sym ints.
QJPMonomial := function(n_sym, mon_exps)
    return rec(sym := ShallowCopy(mon_exps), ext := []);
end;;

# ---- m = 1: D_8 ------------------------------------------------------
#
# H^*(D_8; F_2) = F_2[b_1_0, b_1_1, c_2_2] / (b_1_0 · b_1_1).
# Verified Poincare series 1/(1-t)^2 = 1, 2, 3, 4, 5, ... — but our
# acceptance is the dim sequence matching HAP at deg 0..4, which is
# also {1, 2, 3, 4, 5}.

QJPBuildM1 := function()
    local sym_gens, rel1;
    sym_gens := [
        rec(name := "b_1_0", deg := 1),
        rec(name := "b_1_1", deg := 1),
        rec(name := "c_2_2", deg := 2)
    ];
    # rel1: b_1_0 · b_1_1.
    rel1 := [ QJPMonomial(3, [1, 1, 0]) ];
    return PolynomialTimesExterior(sym_gens, [], [rel1]);
end;;

# ---- m = 2: E_+(2) ---------------------------------------------------
#
# 5 sym_gens, 2 relations.
# Acceptance: dims at deg 0..4 = {1, 4, 9, 15, 22}.

QJPBuildM2 := function()
    local sym_gens, rel1, rel2;
    sym_gens := [
        rec(name := "b_1_0",  deg := 1),  # 1
        rec(name := "b_1_1",  deg := 1),  # 2
        rec(name := "b_1_2",  deg := 1),  # 3
        rec(name := "b_1_3",  deg := 1),  # 4
        rec(name := "c_4_21", deg := 4)   # 5
    ];
    # rel1 (deg 2): b_1_1·b_1_2 + b_1_0·b_1_3 + b_1_0·b_1_1.
    rel1 := [
        QJPMonomial(5, [0, 1, 1, 0, 0]),  # b_1_1·b_1_2
        QJPMonomial(5, [1, 0, 0, 1, 0]),  # b_1_0·b_1_3
        QJPMonomial(5, [1, 1, 0, 0, 0])   # b_1_0·b_1_1
    ];
    # rel2 (deg 3): b_1_0·b_1_3^2 + b_1_0·b_1_2·b_1_3 + b_1_0·b_1_1·b_1_3.
    rel2 := [
        QJPMonomial(5, [1, 0, 0, 2, 0]),  # b_1_0·b_1_3^2
        QJPMonomial(5, [1, 0, 1, 1, 0]),  # b_1_0·b_1_2·b_1_3
        QJPMonomial(5, [1, 1, 0, 1, 0])   # b_1_0·b_1_1·b_1_3
    ];
    return PolynomialTimesExterior(sym_gens, [], [rel1, rel2]);
end;;

# ---- m = 3: E_+(3) ---------------------------------------------------
#
# 7 sym_gens, 3 relations. Only the first two relations transcribed
# below; rel3 (deg 5, 33 terms) is a follow-up.
# Acceptance dims at deg 0..4: TBD — call HAP and record.

QJPBuildM3 := function()
    local sym_gens, rel1, rel2;
    sym_gens := [
        rec(name := "b_1_0",   deg := 1),   # 1
        rec(name := "b_1_1",   deg := 1),   # 2
        rec(name := "b_1_2",   deg := 1),   # 3
        rec(name := "b_1_3",   deg := 1),   # 4
        rec(name := "b_1_4",   deg := 1),   # 5
        rec(name := "b_1_5",   deg := 1),   # 6
        rec(name := "c_8_580", deg := 8)    # 7
    ];
    # rel1 (deg 2): b_1_2·b_1_3 + b_1_1·b_1_4 + b_1_0·b_1_5 + b_1_0·b_1_1.
    rel1 := [
        QJPMonomial(7, [0, 0, 1, 1, 0, 0, 0]),  # b_1_2·b_1_3
        QJPMonomial(7, [0, 1, 0, 0, 1, 0, 0]),  # b_1_1·b_1_4
        QJPMonomial(7, [1, 0, 0, 0, 0, 1, 0]),  # b_1_0·b_1_5
        QJPMonomial(7, [1, 1, 0, 0, 0, 0, 0])   # b_1_0·b_1_1
    ];
    # rel2 (deg 3):
    #   b_1_1·b_1_4^2 + b_1_1·b_1_3·b_1_4 + b_1_1·b_1_2·b_1_4 + b_1_1^2·b_1_4
    # + b_1_0·b_1_5^2 + b_1_0·b_1_3·b_1_5 + b_1_0·b_1_2·b_1_5
    # + b_1_0·b_1_1·b_1_3 + b_1_0·b_1_1·b_1_2 + b_1_0·b_1_1^2
    # + b_1_0^2·b_1_5 + b_1_0^2·b_1_1.
    rel2 := [
        QJPMonomial(7, [0, 1, 0, 0, 2, 0, 0]),  # b_1_1·b_1_4^2
        QJPMonomial(7, [0, 1, 0, 1, 1, 0, 0]),  # b_1_1·b_1_3·b_1_4
        QJPMonomial(7, [0, 1, 1, 0, 1, 0, 0]),  # b_1_1·b_1_2·b_1_4
        QJPMonomial(7, [0, 2, 0, 0, 1, 0, 0]),  # b_1_1^2·b_1_4
        QJPMonomial(7, [1, 0, 0, 0, 0, 2, 0]),  # b_1_0·b_1_5^2
        QJPMonomial(7, [1, 0, 0, 1, 0, 1, 0]),  # b_1_0·b_1_3·b_1_5
        QJPMonomial(7, [1, 0, 1, 0, 0, 1, 0]),  # b_1_0·b_1_2·b_1_5
        QJPMonomial(7, [1, 1, 0, 1, 0, 0, 0]),  # b_1_0·b_1_1·b_1_3
        QJPMonomial(7, [1, 1, 1, 0, 0, 0, 0]),  # b_1_0·b_1_1·b_1_2
        QJPMonomial(7, [1, 2, 0, 0, 0, 0, 0]),  # b_1_0·b_1_1^2
        QJPMonomial(7, [2, 0, 0, 0, 0, 1, 0]),  # b_1_0^2·b_1_5
        QJPMonomial(7, [2, 1, 0, 0, 0, 0, 0])   # b_1_0^2·b_1_1
    ];
    # rel3 (deg 5, 33 terms) — TODO: transcribe from Jena.
    return PolynomialTimesExterior(sym_gens, [], [rel1, rel2]);
end;;

# ---- Public entry point ----------------------------------------------

JenaPresentation := function(m)
    if m = 1 then return QJPBuildM1(); fi;
    if m = 2 then return QJPBuildM2(); fi;
    if m = 3 then return QJPBuildM3(); fi;
    Error("JenaPresentation: only m in {1, 2, 3} are transcribed");
end;;

Print("Loaded quillen_jena_presentation.g (JenaPresentation 1..3).\n");
