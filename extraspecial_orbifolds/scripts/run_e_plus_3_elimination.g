# run_e_plus_3_elimination.g — A-3c driver: candidate-elimination loop
# for non-zero [ω] ∈ ker Tr(E_+(3)).
#
# Implements issue #44 (A-3c).
#
# Background:
#   At m=3, ker Tr = H^3(E_+(3); U(1)) (the transgression is identically
#   zero — confirmed by A-3a's kernel.g). Every non-zero class is a
#   candidate for distinguishing "twisted vs untwisted" modular data.
#
#   For each candidate vec ∈ (Z/torsion)^35 \ {0}, we apply two invariants:
#     * Tier 1 (V-2): twisted central-row S-entry ε_ω phase. If S^ω entry
#       differs from S^0, candidate is "eliminated" (i.e. the twist
#       genuinely changes the modular data at that entry).
#     * Tier 5 (V-3): FS-indicators ν_n((g, χ)) for n ∈ {2, 4}. If any
#       ν_n^ω disagrees with ν_n^0, eliminated.
#
#   "Agrees" candidates are *potentially problematic* — they're invisible
#   to these invariants and would require finer tests (full S spectrum,
#   colour refinement on fusion-row signatures, Aut(N, T), …).
#
# Scope (per issue #44 comments):
#   * BRW orbit reduction: at minimum reduce 35 unit basis vectors to
#     their BRW orbit reps. Orbits among non-unit-basis vectors are out
#     of scope here — adding them is a follow-up. The point of A-3c is a
#     proof-of-concept elimination report, not a complete kernel survey.
#   * Tier-1 entry: try a few candidate (g1, χ1, g2, χ2) tuples, pick
#     the one with maximum |ε_ω − ε_0| (most discriminating).
#   * Tier-5 sweep: n ∈ {2, 4} at one chosen simple per candidate.
#
# Usage:
#   gap -q -b -c 'Read("run_e_plus_3_elimination.g");'
# from extraspecial_orbifolds/scripts/.

Read("brw_h3_action.g");
Read("transgression_kernel.g");
Read("s_twisted_central.g");
Read("fsi_wrapper.g");

t_start := Runtime();;

Print("\n=== A-3c driver: candidate elimination for E_+(3) ===\n");

# ----------------------------------------------------------------------
# Step 1: build BRW H^3 action, find orbit reps among unit basis vectors.
# ----------------------------------------------------------------------

Print("\n--- Step 1: BRW H^3 action + orbit reduction on unit basis ---\n");

t_brw := Runtime();;
m := 3;;
h3_action := BRWH3Action(m);;
Print("BRWH3Action(", m, ") wall: ", (Runtime() - t_brw) / 1000., " s\n");

G := h3_action.em;;
setup := h3_action.setup;;
torsion := setup.torsion;;
exp := setup.exponent;;
k := setup.num_generators;;
h3_matrices := h3_action.matrices;;

Print("|G| = ", Order(G), ", k = ", k, ", torsion = ", torsion, "\n");
Print("|H^3| = ", Product(torsion), "\n");

# Orbit-find among the 35 unit basis vectors under BRW H^3-action.
# State key: an immutable representation of vec mod torsion. Two vecs
# represent the same H^3 class iff they agree component-wise mod
# torsion[i].

ReduceVec := function(v)
    return List([1..Length(v)], i -> v[i] mod torsion[i]);
end;;

ApplyMatrix := function(M, v)
    return ReduceVec(M * v);
end;;

# BFS orbit of a starting vec. Returns Set of canonical reps.
OrbitOf := function(seed)
    local orbit, frontier, v, M_y, w;
    orbit := [];
    AddSet(orbit, ReduceVec(seed));
    frontier := [ReduceVec(seed)];
    while not IsEmpty(frontier) do
        v := Remove(frontier);
        for M_y in h3_matrices do
            w := ApplyMatrix(M_y, v);
            if not (w in orbit) then
                AddSet(orbit, w);
                Add(frontier, w);
            fi;
        od;
    od;
    return orbit;
end;;

unit_basis_orbits := [];;
orbit_reps := [];;
covered := [];;
for i in [1..k] do
    e_i := ListWithIdenticalEntries(k, 0);
    e_i[i] := 1;
    e_i := ReduceVec(e_i);
    if e_i in covered then continue; fi;
    orbit := OrbitOf(e_i);
    Add(unit_basis_orbits, rec(rep := e_i, rep_index := i,
                                size := Length(orbit), members := orbit));
    Add(orbit_reps, e_i);
    UniteSet(covered, orbit);
    Print("  orbit ", Length(unit_basis_orbits),
          ": rep = e_", i, ", |orbit| = ", Length(orbit), "\n");
od;
Print("Total unit-basis BRW orbits: ", Length(orbit_reps),
      " (out of ", k, " unit basis vectors)\n");

# ----------------------------------------------------------------------
# Step 2: per-rep elimination via Tier-1 ε_ω and Tier-5 ν_n.
# ----------------------------------------------------------------------

Print("\n--- Step 2: applying V-2 (Tier 1) + V-3 (Tier 5) per orbit rep ---\n");

# Untwisted reference omega: the all-zero vec. f(g1, g2, g3) = 0.
zero_vec := ListWithIdenticalEntries(k, 0);;
omega_0 := StandardCocycleOf(setup, zero_vec);;

# Pick a central element of order 2 (the unique non-trivial central
# element in E_+(3); generated by the squaring map). For E_+(m) as a
# pc-group, IsCentral + Order ≤ 2 picks it out.
central_minus_one := fail;;
for x in G do
    if IsCentral(G, x) and Order(x) = 2 then
        central_minus_one := x;
        break;
    fi;
od;;
if central_minus_one = fail then
    Error("No central order-2 element in G — m=3 should always have one");
fi;
Print("Central order-2 element g1 = ", central_minus_one, "\n");

# Pick a non-central g2 (the first conjugacy class rep with |C_G(g)| < |G|).
classes := ConjugacyClasses(G);;
g2 := fail;;
for c in classes do
    if Order(Centralizer(G, Representative(c))) < Order(G) then
        g2 := Representative(c);
        break;
    fi;
od;;
if g2 = fail then Error("No non-central class found"); fi;
Print("Non-central g2 = ", g2, " (|C| = ",
      Order(Centralizer(G, g2)), ")\n");

# Trivial characters as a baseline. χ(_) = 1.
trivial_chi := function(_) return 1; end;;

# Compute the baseline S^0 entry once.
t_s0 := Runtime();;
s0_entry := STwistedCentralEntry(G, omega_0, exp,
                                  central_minus_one, trivial_chi,
                                  g2, trivial_chi);;
Print("S^0 (g1, triv, g2, triv) = ", s0_entry,
      " (", (Runtime() - t_s0) / 1000., " s)\n");

# A non-trivial simple for FSI: pick (g2, trivial_chi). For E_+(3) with
# 35 classes this is one specific (class, character) coordinate. Stage 1
# of the report just records (ν_2^ω, ν_4^ω) at this fixed simple; if all
# 35 unit-basis classes agree with the untwisted FSI at this simple, we
# need a richer sweep.
fsi_class_rep := g2;;
fsi_chi_index := 1;;   # first character of the centraliser of g2

# Untwisted FSI baseline. FSIContext builds H^3 + UCT internally.
t_ctx0 := Runtime();;
ctx_0 := FSIContext(G, zero_vec);;
fsi_0_n2 := FSI(ctx_0, fsi_class_rep, fsi_chi_index, 2);;
fsi_0_n4 := FSI(ctx_0, fsi_class_rep, fsi_chi_index, 4);;
Print("ν_2^0 = ", fsi_0_n2, ", ν_4^0 = ", fsi_0_n4,
      " (", (Runtime() - t_ctx0) / 1000., " s)\n");

# Loop over orbit reps.
report := [];;
for orbit_info in unit_basis_orbits do
    rep := orbit_info.rep;
    rep_index := orbit_info.rep_index;
    Print("\nCandidate: orbit rep = e_", rep_index, " (|orbit| = ",
          orbit_info.size, ")\n");
    t_one := Runtime();
    omega := StandardCocycleOf(setup, rep);
    s_omega := STwistedCentralEntry(G, omega, exp,
                                     central_minus_one, trivial_chi,
                                     g2, trivial_chi);
    eps_eliminated := (s_omega <> s0_entry);
    Print("  S^ω entry = ", s_omega,
          "  (eliminated by ε_ω? ", eps_eliminated, ")\n");

    ctx := FSIContext(G, rep);
    fsi_w_n2 := FSI(ctx, fsi_class_rep, fsi_chi_index, 2);
    fsi_w_n4 := FSI(ctx, fsi_class_rep, fsi_chi_index, 4);
    fsi_eliminated_n2 := (fsi_w_n2 <> fsi_0_n2);
    fsi_eliminated_n4 := (fsi_w_n4 <> fsi_0_n4);
    fsi_eliminated := fsi_eliminated_n2 or fsi_eliminated_n4;
    Print("  ν_2^ω = ", fsi_w_n2,
          "  (eliminated by ν_2? ", fsi_eliminated_n2, ")\n");
    Print("  ν_4^ω = ", fsi_w_n4,
          "  (eliminated by ν_4? ", fsi_eliminated_n4, ")\n");

    verdict := "agrees-on-test";
    if eps_eliminated or fsi_eliminated then verdict := "eliminated"; fi;
    Print("  Verdict: ", verdict,
          "  (", (Runtime() - t_one) / 1000., " s)\n");

    Add(report, rec(orbit_rep_index := rep_index,
                     orbit_size := orbit_info.size,
                     s_omega := s_omega,
                     fsi_n2 := fsi_w_n2,
                     fsi_n4 := fsi_w_n4,
                     eps_eliminated := eps_eliminated,
                     fsi_eliminated := fsi_eliminated,
                     verdict := verdict));
od;

# ----------------------------------------------------------------------
# Step 3: summary + persist.
# ----------------------------------------------------------------------

Print("\n--- Step 3: summary ---\n");
n_eliminated := Number(report, r -> r.verdict = "eliminated");;
n_agrees := Number(report, r -> r.verdict = "agrees-on-test");;
Print("Eliminated orbits:    ", n_eliminated, " / ", Length(report), "\n");
Print("Agrees-on-test orbits: ", n_agrees, " / ", Length(report), "\n");
if n_agrees > 0 then
    Print("Agrees-on-test orbit reps (need richer sweep): ",
          List(Filtered(report, r -> r.verdict = "agrees-on-test"),
               r -> r.orbit_rep_index), "\n");
fi;

OutDir := "../../computed/elimination/3";;
Exec(Concatenation("mkdir -p ", OutDir));
OutPath := Concatenation(OutDir, "/unit_basis_results.g");;
stream := OutputTextFile(OutPath, false);;
SetPrintFormattingStatus(stream, false);
PrintTo(stream,
    "# A-3c candidate elimination at m=3 (unit-basis BRW orbits).\n",
    "# Issue #44. Generated by run_e_plus_3_elimination.g.\n",
    "#\n",
    "# Convention: report[i] is one orbit. `orbit_rep_index` indexes the\n",
    "# unit basis vector that's the rep. `verdict` ∈ {eliminated, agrees-on-test}.\n",
    "# eps_eliminated / fsi_eliminated split the verdict by invariant.\n",
    "#\n",
    "# Tier-1 fixed coords: g1 = central order-2, g2 = first non-central rep,\n",
    "# χ1 = χ2 = trivial. Tier-5 fixed coords: (g, χ_index) = (g2, 1), n ∈ {2, 4}.\n",
    "# Wall: ", (Runtime() - t_start) / 1000., " s.\n",
    "\n",
    "return rec(\n",
    "    group := \"E_+(3)\",\n",
    "    torsion := ", torsion, ",\n",
    "    exp := ", exp, ",\n",
    "    n_orbits := ", Length(report), ",\n",
    "    n_eliminated := ", n_eliminated, ",\n",
    "    n_agrees := ", n_agrees, ",\n",
    "    report := ", report, "\n",
    ");;\n");
CloseStream(stream);
Print("Wrote ", OutPath, "\n");

Print("\n=== A-3c driver: DONE ===\n");
Print("Total wall: ", (Runtime() - t_start) / 1000., " s\n");
