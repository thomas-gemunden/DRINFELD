# For cocycles 1 and 2 of Q_8, label each row of the modular data with
# (conjugacy class representative, dimension, identifier) and find the
# permutation aligning the fresh in-memory ordering with the stored order.

Read("../../src/modular_data.g");

# Convert to a printable group element name for Q_8.
# Standard GAP Q_8 generators: SmallGroup(8,4) is generated by f1, f2 with
# specific relations. We'll just use Q_8's natural names by matching orders
# and a chosen set of generators.

LabelQ8Element := function(G, x)
    local order, identif;
    order := Order(x);
    if order = 1 then return "1"; fi;
    if order = 2 then return "-1"; fi;
    # order = 4: there are 6 elements of order 4 forming three pairs {±i},{±j},{±k}.
    # We'll just label by an index 1..6 in canonical GAP order.
    return Concatenation("(ord4):", String(Position(Set(Filtered(G, y -> Order(y) = 4)), x)));
end;;

ClassLabel := function(G, c)
    local rep, sz, ord;
    rep := Representative(c);
    sz := Size(c);
    ord := Order(rep);
    if ord = 1 then return "{1}"; fi;
    if ord = 2 then return "{-1}"; fi;
    # size-2 conjugacy class of order-4 elements
    return Concatenation("{cls", String(Position(ConjugacyClasses(G), c)), ",ord4,sz", String(sz), "}");
end;;

DescribeSimples := function(simples, G)
    local lst, i, s, label, cls;
    lst := [];
    for i in [1..Length(simples)] do
        s := simples[i];
        cls := First(ConjugacyClasses(G), c -> s.representative in c);
        label := Concatenation(
            "i=", String(i),
            "  g_class=", ClassLabel(G, cls),
            "  rep_dim=", String(s.dimension)
        );
        Add(lst, label);
    od;
    return lst;
end;;

# Reuse FindEquivPerm.
FindEquivPerm := function(Sa, Ta, Sb, Tb)
    local n, sigA, sigB, candidates, search, found;
    n := Length(Ta);
    sigA := List([1..n], i -> [Ta[i], SortedList(Sa[i])]);
    sigB := List([1..n], i -> [Tb[i], SortedList(Sb[i])]);
    candidates := List([1..n], i -> Filtered([1..n], j -> sigB[i] = sigA[j]));
    search := function(assigned, remaining, used)
        local i, j, ok, k;
        if remaining = [] then
            for i in [1..n] do for j in [1..n] do
                if Sb[i][j] <> Sa[assigned[i]][assigned[j]] then return fail; fi;
            od; od;
            return assigned;
        fi;
        i := remaining[1];
        for j in candidates[i] do
            if not j in used then
                assigned[i] := j;
                ok := true;
                for k in [1..n] do
                    if IsBound(assigned[k]) and Sb[i][k] <> Sa[j][assigned[k]] then
                        ok := false; break;
                    fi;
                od;
                if ok then
                    AddSet(used, j);
                    found := search(assigned, remaining{[2..Length(remaining)]}, used);
                    if found <> fail then return found; fi;
                    RemoveSet(used, j);
                fi;
                Unbind(assigned[i]);
            fi;
        od;
        return fail;
    end;
    return search([], List(SortedList(List([1..n], i -> [Length(candidates[i]), i])), p -> p[2]), []);
end;;

G := SmallGroup(8, 4);;
R := ResolutionFiniteGroup(G, 4);;
K := TensorWithIntegers(R);;
UCT := UniversalCoefficientsTheorem(K, 3);;
m := UCT.exponent;;

storedCocycles := ReadAsFunction("Modular_Data/8/4/3-cocycles.txt")();;

ProcessCocycle := function(idx)
    local vec, val, exp, omega, simples_data, simples, freshS_T, freshS, freshT,
          freshLabels, stored, storedT, perm, storedLabels, i;
    vec := storedCocycles[idx];
    val := Gcd(Concatenation([m], Filtered(vec, x -> x <> 0)));
    if Filtered(vec, x -> x <> 0) = [] then val := m; fi;
    exp := m / val;
    omega := StandardCocycle(R, vec, 3, m);

    simples_data := GenerateSimpleObjects(G, omega, val, exp);
    simples := simples_data.Simp;
    freshLabels := DescribeSimples(simples, G);

    freshS_T := GenerateModularData(G, omega, val, exp, simples);
    freshS := freshS_T.S;
    freshT := DiagonalOfMat(freshS_T.T);

    stored := LoadModularData(8, 4, idx);
    storedT := DiagonalOfMat(stored.T);

    # Permutation: stored row j corresponds to fresh row perm[j]
    # i.e. stored S[j][k] = fresh S[perm[j]][perm[k]]
    perm := FindEquivPerm(freshS, freshT, stored.S, storedT);
    Print("\n--- Cocycle ", idx, " (vec=", vec, ", order=", exp, ") ---\n");
    Print("Permutation fresh->stored: ", perm, "\n");
    storedLabels := List([1..Length(perm)], j -> freshLabels[perm[j]]);
    Print("Labels in STORED order:\n");
    for i in [1..Length(storedLabels)] do
        Print("  row ", i, "  T=", storedT[i], "  ", storedLabels[i],
              "  S_diag=", stored.S[i][i], "\n");
    od;
    return rec(perm := perm, freshLabels := freshLabels, storedLabels := storedLabels,
               simples := simples);
end;;

result1 := ProcessCocycle(1);;
result2 := ProcessCocycle(2);;

# Apply pi_F (the fusion-ring iso) and see what label-class structure emerges.
piF := [1, 2, 3, 4, 5, 8, 9, 6, 7, 12, 13, 10, 11, 14, 16, 17, 15, 18, 21, 22, 19, 20];;
Print("\n--- pi_F (fusion-ring iso, stored row of data1 -> stored row of data2) ---\n");
for i in [1..22] do
    Print("  data1 row ", i, " (", result1.storedLabels[i],
          ", T=", DiagonalOfMat(LoadModularData(8,4,1).T)[i],
          ")  -->  data2 row ", piF[i], " (", result2.storedLabels[piF[i]],
          ", T=", DiagonalOfMat(LoadModularData(8,4,2).T)[piF[i]], ")\n");
od;

QUIT;
